{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "DevOpsHero ECS Cluster - Fargate cluster with IAM roles for app deployments",

  "Resources": {
    "EcsCluster": {
      "Type": "AWS::ECS::Cluster",
      "Properties": {
        "ClusterName": "devopshero-cluster",
        "ClusterSettings": [
          {
            "Name": "containerInsights",
            "Value": "enabled"
          }
        ],
        "Tags": [
          { "Key": "Name", "Value": "devopshero-cluster" }
        ]
      }
    },

    "EcsTaskExecutionRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "devopshero-ecs-task-execution-role",
        "Description": "Role for ECS to pull images from ECR and write logs to CloudWatch",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AmazonECSTaskExecutionRolePolicy"
        ],
        "Tags": [
          { "Key": "Name", "Value": "devopshero-ecs-task-execution-role" }
        ]
      }
    },

    "EcsTaskRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "devopshero-ecs-task-role",
        "Description": "Role for applications running in ECS tasks to access AWS services",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ecs-tasks.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "Tags": [
          { "Key": "Name", "Value": "devopshero-ecs-task-role" }
        ]
      }
    },

    "EcsLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/devopshero/ecs",
        "RetentionInDays": 30,
        "Tags": [
          { "Key": "Name", "Value": "devopshero-ecs-logs" }
        ]
      }
    }
  },

  "Outputs": {
    "ClusterArn": {
      "Description": "ECS Cluster ARN",
      "Value": { "Fn::GetAtt": ["EcsCluster", "Arn"] },
      "Export": { "Name": "devopshero-cluster-arn" }
    },
    "ClusterName": {
      "Description": "ECS Cluster Name",
      "Value": { "Ref": "EcsCluster" },
      "Export": { "Name": "devopshero-cluster-name" }
    },
    "TaskExecutionRoleArn": {
      "Description": "ECS Task Execution Role ARN",
      "Value": { "Fn::GetAtt": ["EcsTaskExecutionRole", "Arn"] },
      "Export": { "Name": "devopshero-task-execution-role-arn" }
    },
    "TaskRoleArn": {
      "Description": "ECS Task Role ARN",
      "Value": { "Fn::GetAtt": ["EcsTaskRole", "Arn"] },
      "Export": { "Name": "devopshero-task-role-arn" }
    },
    "LogGroupName": {
      "Description": "CloudWatch Log Group for ECS tasks",
      "Value": { "Ref": "EcsLogGroup" },
      "Export": { "Name": "devopshero-ecs-log-group" }
    }
  }
}
