#!/opt/hermes/webui/venv/bin/python3
"""HUMR webapps CLI: register, manage, and route user-built web apps.

Source of truth:
/workspace/.config/process-compose/webapps/process-compose.yaml. Caddy routes
in /workspace/.config/caddy/routes.caddy are regenerated from that file on
every change.

See template_repos/hermes_agent/skills/development/webapps/SKILL.md for the agent contract.
"""
from __future__ import annotations

import argparse
import os
import shutil
import sys
from pathlib import Path

sys.path.insert(0, "/opt/humr/runtime/webapps")
from webapps_lib import (
    DEFAULT_TIMEOUT_SECONDS,
    LOGS_DIR,
    WEBAPPS_PROJECT,
    ProcessComposeLock,
    die,
    is_internal_slug,
    is_routed,
    load_process_compose_yaml,
    make_process_entry,
    next_free_port,
    port_from_entry,
    process_compose_project_update,
    process_compose_states,
    regenerate_routes,
    run_process_compose,
    save_process_compose_yaml,
    url_for,
    validate_slug,
    wait_for_ready,
)


def apply_env_pairs(entry: dict, pairs: list[str]) -> None:
    env_map = {
        e.split("=", 1)[0]: e.split("=", 1)[1]
        for e in entry.get("environment", [])
        if "=" in e
    }
    for kv in pairs:
        if "=" not in kv:
            die(f"bad KEY=VALUE pair: {kv!r}")
        key, value = kv.split("=", 1)
        env_map[key] = value
    entry["environment"] = [f"{key}={value}" for key, value in env_map.items()]


def cmd_create(args: argparse.Namespace) -> None:
    validate_slug(args.slug)
    cwd = Path(args.cwd).resolve()
    if not cwd.is_dir():
        die(f"--cwd {cwd} is not a directory; create the project first")

    with ProcessComposeLock(project=WEBAPPS_PROJECT):
        doc = load_process_compose_yaml(project=WEBAPPS_PROJECT)
        if args.slug in doc["processes"]:
            if args.if_missing:
                # Routes file isn't versioned with the YAML, so an interrupted
                # prior bootstrap (or state drift) might leave the route
                # missing even though the entry exists. Regenerate to be sure.
                regenerate_routes(doc)
                print(f"webapps: {args.slug!r} already exists; routes refreshed.")
                return
            die(f"app {args.slug!r} already exists; unregister it first or pick another slug")

        port = next_free_port(doc)
        entry = make_process_entry(
            slug=args.slug,
            command=args.command,
            cwd=str(cwd),
            port=port,
        )
        apply_env_pairs(entry=entry, pairs=list(args.env))
        if not args.bootstrap_enabled:
            entry["disabled"] = True
        doc["processes"][args.slug] = entry
        save_process_compose_yaml(project=WEBAPPS_PROJECT, doc=doc)
        regenerate_routes(doc)

    if args.bootstrap_enabled:
        print(f"webapps: registered {args.slug!r} on port {port} (bootstrap-enabled; supervisor will pick it up).")
        return
    print(f"webapps: registered {args.slug!r} on port {port} (stopped). Run `webapps start {args.slug}` when ready.")


def cmd_list(_args: argparse.Namespace) -> None:
    doc = load_process_compose_yaml(project=WEBAPPS_PROJECT)
    procs = doc.get("processes", {})
    if not procs:
        print("No webapps yet.")
        print("")
        print("Try:")
        print("  webapps create my-app --command 'python -m http.server $WEBAPP_PORT' --cwd /workspace/webapps/projects/my-app")
        print("  webapps start my-app")
        return

    states = {s["name"]: s for s in process_compose_states(project=WEBAPPS_PROJECT)}
    print(f"{'SLUG':<20} {'PORT':<6} {'STATUS':<14} {'READY':<10} {'URL'}")
    for slug, entry in sorted(procs.items()):
        port = port_from_entry(entry)
        st = states.get(slug, {})
        url = url_for(slug) if is_routed(entry) else "(stopped)"
        print(
            f"{slug:<20} {port or '-':<6} {st.get('status', 'Pending'):<14} "
            f"{st.get('is_ready', 'Unknown'):<10} {url}"
        )


def cmd_logs(args: argparse.Namespace) -> None:
    log_path = LOGS_DIR / f"{args.slug}.log"
    if not log_path.exists():
        die(f"no log file at {log_path} (app may not have started yet)")
    cmd = ["tail"]
    if args.follow:
        cmd.append("-f")
    cmd.extend(["-n", str(args.lines), str(log_path)])
    os.execvp(cmd[0], cmd)


def cmd_start(args: argparse.Namespace) -> None:
    with ProcessComposeLock(project=WEBAPPS_PROJECT):
        doc = load_process_compose_yaml(project=WEBAPPS_PROJECT)
        entry = doc["processes"].get(args.slug)
        if entry is None:
            die(f"unknown app {args.slug!r}")
        entry.pop("disabled", None)
        save_process_compose_yaml(project=WEBAPPS_PROJECT, doc=doc)
        regenerate_routes(doc)
        process_compose_project_update(project=WEBAPPS_PROJECT)

    print(f"webapps: starting {args.slug!r}; waiting up to {args.timeout}s for readiness...")
    state = wait_for_ready(args.slug, args.timeout)
    if state.get("is_ready") != "Ready":
        die(
            f"{args.slug} did not become ready (status={state.get('status')}, "
            f"is_ready={state.get('is_ready')}, exit_code={state.get('exit_code')}, "
            f"restarts={state.get('restarts')}). The process-compose readiness probe "
            f"may have stopped or restarted it before it bound the port. "
            f"Check `webapps logs {args.slug}`."
        )

    print(f"webapps: {args.slug!r} is live at {url_for(args.slug)}")


def cmd_stop(args: argparse.Namespace) -> None:
    with ProcessComposeLock(project=WEBAPPS_PROJECT):
        doc = load_process_compose_yaml(project=WEBAPPS_PROJECT)
        entry = doc["processes"].get(args.slug)
        if entry is None:
            die(f"unknown app {args.slug!r}")
        entry["disabled"] = True
        save_process_compose_yaml(project=WEBAPPS_PROJECT, doc=doc)
        regenerate_routes(doc)
        process_compose_project_update(project=WEBAPPS_PROJECT)
    print(f"webapps: {args.slug!r} stopped (URL now 404s).")


def cmd_restart(args: argparse.Namespace) -> None:
    with ProcessComposeLock(project=WEBAPPS_PROJECT):
        doc = load_process_compose_yaml(project=WEBAPPS_PROJECT)
        entry = doc["processes"].get(args.slug)
        if entry is None:
            die(f"unknown app {args.slug!r}")
        if entry.get("disabled"):
            die(f"{args.slug!r} is stopped; use `webapps start {args.slug}`")
    run_process_compose("process", "restart", args.slug, project=WEBAPPS_PROJECT, check=True, capture=False)
    with ProcessComposeLock(project=WEBAPPS_PROJECT):
        regenerate_routes(load_process_compose_yaml(project=WEBAPPS_PROJECT))
    print(f"webapps: {args.slug!r} restarted.")


def cmd_reload(_args: argparse.Namespace) -> None:
    with ProcessComposeLock(project=WEBAPPS_PROJECT):
        doc = load_process_compose_yaml(project=WEBAPPS_PROJECT)
        regenerate_routes(doc)
        process_compose_project_update(project=WEBAPPS_PROJECT)

    print("webapps: resynced process-compose config and regenerated routes.")


def cmd_set_env(args: argparse.Namespace) -> None:
    with ProcessComposeLock(project=WEBAPPS_PROJECT):
        doc = load_process_compose_yaml(project=WEBAPPS_PROJECT)
        entry = doc["processes"].get(args.slug)
        if entry is None:
            die(f"unknown app {args.slug!r}")

        apply_env_pairs(entry=entry, pairs=list(args.kv))
        save_process_compose_yaml(project=WEBAPPS_PROJECT, doc=doc)
        if not entry.get("disabled"):
            process_compose_project_update(project=WEBAPPS_PROJECT)
    print(f"webapps: env updated for {args.slug!r}.")


def cmd_unregister(args: argparse.Namespace) -> None:
    with ProcessComposeLock(project=WEBAPPS_PROJECT):
        doc = load_process_compose_yaml(project=WEBAPPS_PROJECT)
        if doc["processes"].pop(args.slug, None) is None:
            die(f"unknown app {args.slug!r}")
        save_process_compose_yaml(project=WEBAPPS_PROJECT, doc=doc)
        regenerate_routes(doc)
        process_compose_project_update(project=WEBAPPS_PROJECT)

    print(f"webapps: {args.slug!r} unregistered; source and logs preserved.")


def cmd_delete(args: argparse.Namespace) -> None:
    if not args.yes:
        die("delete requires --yes (this WILL also remove projects/<slug>/ and logs)")

    with ProcessComposeLock(project=WEBAPPS_PROJECT):
        doc = load_process_compose_yaml(project=WEBAPPS_PROJECT)
        if doc["processes"].pop(args.slug, None) is None:
            die(f"unknown app {args.slug!r}")
        save_process_compose_yaml(project=WEBAPPS_PROJECT, doc=doc)
        regenerate_routes(doc)
        process_compose_project_update(project=WEBAPPS_PROJECT)

        log_path = LOGS_DIR / f"{args.slug}.log"
        if log_path.exists():
            log_path.unlink()
        proj_path = Path("/workspace/webapps/projects") / args.slug
        if proj_path.exists():
            shutil.rmtree(proj_path)

    print(f"webapps: {args.slug!r} deleted.")


def cmd_expose(args: argparse.Namespace) -> None:
    """Print the control-plane link where a human can make this webapp public.

    Publishing is a control-plane action, not an agent capability: this
    command only builds the deep link. The app owner opens it, sees the exact
    hostname that would become public, and confirms there.
    """
    validate_slug(args.slug)
    if is_internal_slug(args.slug):
        die(f"{args.slug!r} is a platform-internal webapp; it cannot be made public")

    doc = load_process_compose_yaml(project=WEBAPPS_PROJECT)
    if args.slug not in doc["processes"]:
        die(f"unknown app {args.slug!r}; create it first (see `webapps list`)")

    control_plane_url = os.environ.get("HUMR_CONTROL_PLANE_URL", "").rstrip("/")
    app_slug = os.environ.get("HUMR_APP_SLUG", "")
    env_slug = os.environ.get("HUMR_ENV_SLUG", "")
    if not (control_plane_url and app_slug and env_slug):
        die(
            "HUMR_CONTROL_PLANE_URL / HUMR_APP_SLUG / HUMR_ENV_SLUG not set; "
            "public exposure needs the control-plane deep link and this "
            "environment doesn't provide it"
        )

    deep_link = f"{control_plane_url}/apps/{app_slug}/public-access/new?slug={args.slug}&env={env_slug}"
    print(f"Public access to {url_for(args.slug)} is granted on the control plane, by a human.")
    print("Ask the app owner to open this link and confirm:")
    print("")
    print(f"  {deep_link}")


def main() -> None:
    p = argparse.ArgumentParser(
        prog="webapps",
        description="Manage user-built web apps served at https://<slug>-<agent-host>/.",
    )
    sub = p.add_subparsers(dest="cmd", required=True)

    pc_create = sub.add_parser("create", help="Register a new web app without starting it.")
    pc_create.add_argument("slug")
    pc_create.add_argument("--command", required=True)
    pc_create.add_argument("--cwd", required=True)
    pc_create.add_argument("--env", action="append", default=[], help="KEY=VALUE pair to set before first start.")
    pc_create.add_argument(
        "--if-missing",
        action="store_true",
        help="Exit 0 silently if the slug already exists. For idempotent bootstrap.",
    )
    pc_create.add_argument(
        "--bootstrap-enabled",
        action="store_true",
        help=argparse.SUPPRESS,
    )
    pc_create.set_defaults(func=cmd_create)

    sub.add_parser("list", help="List webapps.").set_defaults(func=cmd_list)

    pc_logs = sub.add_parser("logs", help="Tail a webapp's stdout/stderr.")
    pc_logs.add_argument("slug")
    pc_logs.add_argument("-f", "--follow", action="store_true")
    pc_logs.add_argument("-n", "--lines", type=int, default=200)
    pc_logs.set_defaults(func=cmd_logs)

    pc_start = sub.add_parser("start", help="Start a previously stopped webapp.")
    pc_start.add_argument("slug")
    pc_start.add_argument("--timeout", type=int, default=DEFAULT_TIMEOUT_SECONDS)
    pc_start.set_defaults(func=cmd_start)

    pc_stop = sub.add_parser("stop", help="Stop a webapp and remove its route.")
    pc_stop.add_argument("slug")
    pc_stop.set_defaults(func=cmd_stop)

    pc_restart = sub.add_parser("restart", help="Restart a webapp's process.")
    pc_restart.add_argument("slug")
    pc_restart.set_defaults(func=cmd_restart)

    sub.add_parser("reload", help="Resync process-compose from YAML and regenerate routes.").set_defaults(func=cmd_reload)

    pc_set_env = sub.add_parser("set-env", help="Add/update env vars on a webapp.")
    pc_set_env.add_argument("slug")
    pc_set_env.add_argument("kv", nargs="+", help="KEY=VALUE pairs.")
    pc_set_env.set_defaults(func=cmd_set_env)

    pc_unregister = sub.add_parser("unregister", help="Remove route/supervision but keep source and logs.")
    pc_unregister.add_argument("slug")
    pc_unregister.set_defaults(func=cmd_unregister)

    pc_delete = sub.add_parser("delete", help="Delete a webapp (route, process, logs, source).")
    pc_delete.add_argument("slug")
    pc_delete.add_argument("--yes", action="store_true")
    pc_delete.set_defaults(func=cmd_delete)

    pc_expose = sub.add_parser("expose", help="Print the control-plane link to make a webapp public (a human confirms there).")
    pc_expose.add_argument("slug")
    pc_expose.set_defaults(func=cmd_expose)

    args = p.parse_args()
    args.func(args)


if __name__ == "__main__":
    main()
