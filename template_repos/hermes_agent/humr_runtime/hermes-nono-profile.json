{
  "extends": "default",
  "meta": {
    "name": "hermes-nono",
    "description": "Hermes WebUI with local AWS broker access"
  },
  "workdir": {
    "access": "readwrite"
  },
  "environment": {
    "allow_vars": [
      "AWS_DEFAULT_REGION",
      "AWS_EC2_METADATA_DISABLED",
      "HUMR_APP_SLUG",
      "HUMR_BIN_DIR",
      "HUMR_CONTROL_PLANE_URL",
      "HUMR_ENV_SLUG",
      "HUMR_LLM_PRESET",
      "HUMR_LOGIN_PATH",
      "HUMR_PLATFORM_CAPABILITIES",
      "HUMR_PUBLIC_HOSTNAME",
      "HUMR_ROOT",
      "HUMR_RUN_DIR",
      "HUMR_RUNTIME_DIR",
      "HOMEBREW_PREFIX",
      "HERMES_HOME",
      "HERMES_WEBUI_AGENT_DIR",
      "HERMES_WEBUI_DIR",
      "HERMES_WEBUI_PYTHON",
      "HERMES_WEBUI_STATE_DIR",
      "HERMES_WEBUI_DEFAULT_WORKSPACE",
      "HERMES_WEBUI_SKIP_ONBOARDING",
      "HERMES_WEBUI_HOST",
      "HERMES_WEBUI_PORT",
      "HERMES_WEBUI_PASSWORD",
      "HERMES_WEBUI_TRUST_FORWARDED_HOST",
      "HERMES_WEBUI_CSP_CONNECT_EXTRA",
      "VIRTUAL_ENV",
      "LANG",
      "LC_*",
      "TERM",
      "USER",
      "MIX_OS_CONCURRENCY_LOCK",
      "ELIXIR_ERL_OPTIONS",
      "RELEASE_DISTRIBUTION",
      "ERL_EPMD_PORT"
    ]
  },
  "filesystem": {
    "allow": [
      "/dev/shm",
      "/etc",
      "/home/linuxbrew",
      "/run",
      "/tmp",
      "/usr",
      "/var",
      "/workspace"
    ],
    "read": [
      "/opt/humr",
      "/opt/hermes",
      "/run/humr/integrations-broker/ca"
    ],
    "read_file": [
      "/opt/humr/runtime/webui.sh",
      "/opt/humr/runtime/process_supervisor/process_supervisor.py",
      "/opt/humr/runtime/process_supervisor/system_process_seed.py",
      "/opt/humr/runtime/http_router/Caddyfile",
      "/opt/humr/runtime/webapps/webapps",
      "/opt/humr/runtime/webapps/webapps_lib.py",
      "/opt/humr/runtime/sandbox_seed.py",
      "/opt/humr/runtime/webapps/seed_example_webapps.py",
      "/opt/humr/runtime/webapps/admin/__main__.py",
      "/opt/humr/runtime/webapps/admin/server.py",
      "/opt/humr/runtime/widgets/widgets",
      "/opt/humr/runtime/widgets/widgets_core.py",
      "/opt/humr/runtime/widgets/widgets_runtime.py",
      "/opt/humr/runtime/widgets/widget-unavailable.html",
      "/opt/humr/bin/aws",
      "/opt/humr/bin/gws",
      "/opt/humr/bin/gh",
      "/opt/humr/bin/caddy",
      "/opt/humr/bin/process-compose",
      "/opt/humr/bin/webapps",
      "/opt/humr/bin/widgets",
      "/.within_container",
      "/etc/passwd",
      "/etc/group",
      "/etc/nsswitch.conf"
    ]
  },
  "network": {
    "network_profile": null,
    "block": true,
    "connect_port": [
      443
    ],
    "listen_port": [
      8642,
      8787,
      8789,
      9956,
      9957,
      4000, 4001, 4002, 4003, 4004, 4005, 4006, 4007, 4008, 4009,
      4010, 4011, 4012, 4013, 4014, 4015, 4016, 4017, 4018, 4019
    ],
    "open_port": [
      8642,
      8787,
      8789,
      9901,
      9902,
      9903,
      9904,
      9905,
      9906,
      9907,
      9950,
      9951,
      9952,
      9956,
      9957,
      4000, 4001, 4002, 4003, 4004, 4005, 4006, 4007, 4008, 4009,
      4010, 4011, 4012, 4013, 4014, 4015, 4016, 4017, 4018, 4019
    ]
  }
}
