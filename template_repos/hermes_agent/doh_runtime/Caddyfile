# DOH webapps reverse proxy. See template_repos/hermes_agent/skills/webapps/.
#
# Caddy listens on 8787, behind policy-proxy (which terminates auth at 8788
# in a sibling container in this task). Caddy routes /webapps/<slug>/* to
# per-app loopback ports in routes.caddy (generated by the webapps CLI);
# everything else falls through to Hermes WebUI on 8789.

{
	admin off
	auto_https off
}

:8787 {
	import /workspace/webapps/routes.caddy
	reverse_proxy 127.0.0.1:8789 {
		# Pass through the X-Forwarded-Host policy-proxy already set (the
		# browser's original Host). Caddy's reverse_proxy default would
		# otherwise *append* its own X-Forwarded-Host header (the immediate
		# Host = 127.0.0.1:8787 from policy-proxy's perspective), and
		# WebUI's CSRF gate would walk both, see the loopback first, and
		# reject the POST as cross-origin.
		header_up X-Forwarded-Host {header.X-Forwarded-Host}
	}
}
