# DOH webapps reverse proxy. See template_repos/hermes_agent/skills/webapps/.
#
# Caddy listens on 8787, behind policy-proxy (which terminates auth at 8788
# in a sibling container in this task). Two routing shapes coexist:
#
#   1. Per-app subdomains for user webapps:
#         <slug>.$DOH_PUBLIC_HOSTNAME -> 127.0.0.1:<webapp-port>
#      Each block lives in routes.caddy, regenerated by the `webapps` CLI.
#
#   2. Path-based platform-internal slugs (e.g. __admin):
#         $DOH_PUBLIC_HOSTNAME/webapps/__admin/* -> 127.0.0.1:<port>
#      Lives in the same routes.caddy. Bare-host scope so the WebUI's
#      same-origin extension can talk to it without CORS.
#
# Everything else on the bare agent host falls through to the Hermes WebUI
# on 8789.
#
# Routing key is X-Forwarded-Host, not Host. Policy-proxy strips the browser's
# original Host before forwarding (standard reverse-proxy behavior — httpx
# rewrites it to the upstream 127.0.0.1:8787) and copies the original value
# into X-Forwarded-Host. See policy_proxy/proxy.py.

{
	admin off
	auto_https off
}

:8787 {
	import /workspace/.config/caddy/routes.caddy

	# Bare agent host fallback: anything not matched by an imported route
	# block goes to the WebUI.
	@bare header X-Forwarded-Host {$DOH_PUBLIC_HOSTNAME}
	handle @bare {
		reverse_proxy 127.0.0.1:8789 {
			header_up X-Forwarded-Host {header.X-Forwarded-Host}
		}
	}

	# Unknown subdomain (a typoed slug, a stale link from a deleted webapp):
	# return 404 instead of empty 200.
	handle {
		respond "unknown host" 404
	}
}
