{
  "extends": "default",
  "meta": {
    "name": "hermes-nono",
    "description": "Hermes WebUI with local AWS broker access"
  },
  "workdir": {
    "access": "readwrite"
  },
  "environment": {
    "allow_vars": [
      "AWS_DEFAULT_REGION",
      "AWS_EC2_METADATA_DISABLED",
      "DOH_BIN_DIR",
      "DOH_CONTROL_PLANE_URL",
      "DOH_LOGIN_PATH",
      "DOH_PUBLIC_HOSTNAME",
      "DOH_ROOT",
      "DOH_RUN_DIR",
      "DOH_RUNTIME_DIR",
      "HOMEBREW_PREFIX",
      "HOMEBREW_NO_ANALYTICS",
      "HOMEBREW_NO_AUTO_UPDATE",
      "HOMEBREW_INSTALL_FROM_API",
      "HERMES_HOME",
      "HERMES_WEBUI_AGENT_DIR",
      "HERMES_WEBUI_DIR",
      "HERMES_WEBUI_PYTHON",
      "HERMES_WEBUI_STATE_DIR",
      "HERMES_WEBUI_DEFAULT_WORKSPACE",
      "HERMES_WEBUI_SKIP_ONBOARDING",
      "HERMES_WEBUI_HOST",
      "HERMES_WEBUI_PORT",
      "HERMES_WEBUI_PASSWORD",
      "HERMES_WEBUI_EXTENSION_DIR",
      "HERMES_WEBUI_EXTENSION_SCRIPT_URLS",
      "HERMES_WEBUI_EXTENSION_STYLESHEET_URLS",
      "VIRTUAL_ENV",
      "LANG",
      "LC_*",
      "TERM",
      "USER"
    ]
  },
  "filesystem": {
    "allow": [
      "/dev/shm",
      "/etc",
      "/home/linuxbrew",
      "/run",
      "/tmp",
      "/usr",
      "/var",
      "/workspace"
    ],
    "read": [
      "/opt/doh",
      "/opt/hermes",
      "/run/doh/integrations-broker/ca"
    ],
    "read_file": [
      "/opt/doh/runtime/webui.sh",
      "/opt/doh/runtime/webapps",
      "/opt/doh/runtime/webapps_lib.py",
      "/opt/doh/runtime/process_compose_seed.py",
      "/opt/doh/runtime/profile_env_exec.py",
      "/opt/doh/runtime/admin/__main__.py",
      "/opt/doh/runtime/admin/server.py",
      "/opt/doh/runtime/Caddyfile",
      "/opt/doh/bin/aws",
      "/opt/doh/bin/gws",
      "/opt/doh/bin/gh",
      "/opt/doh/bin/caddy",
      "/opt/doh/bin/process-compose",
      "/opt/doh/bin/webapps",
      "/.within_container",
      "/etc/passwd",
      "/etc/group",
      "/etc/nsswitch.conf"
    ]
  },
  "network": {
    "network_profile": null,
    "block": true,
    "connect_port": [
      443
    ],
    "listen_port": [
      8642,
      8787,
      8789,
      9956,
      4000, 4001, 4002, 4003, 4004, 4005, 4006, 4007, 4008, 4009,
      4010, 4011, 4012, 4013, 4014, 4015, 4016, 4017, 4018, 4019
    ],
    "open_port": [
      8642,
      8787,
      8789,
      9901,
      9902,
      9903,
      9904,
      9950,
      9951,
      9952,
      9956,
      4000, 4001, 4002, 4003, 4004, 4005, 4006, 4007, 4008, 4009,
      4010, 4011, 4012, 4013, 4014, 4015, 4016, 4017, 4018, 4019
    ]
  }
}
