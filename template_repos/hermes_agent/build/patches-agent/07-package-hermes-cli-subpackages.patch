Include hermes_cli subpackages in the installed wheel.

Hermes Agent's dashboard and proxy code imports subpackages under
hermes_cli, but the setuptools discovery list only includes the top-level
hermes_cli package. The built wheel therefore ships modules like
hermes_cli.web_server while dropping hermes_cli.dashboard_auth and
hermes_cli.proxy, making `hermes dashboard` fail at runtime.

--- a/pyproject.toml
+++ b/pyproject.toml
@@ -236,7 +236,7 @@ plugins = [
 ]
 
 [tool.setuptools.packages.find]
-include = ["agent", "agent.*", "tools", "tools.*", "hermes_cli", "gateway", "gateway.*", "tui_gateway", "tui_gateway.*", "cron", "acp_adapter", "plugins", "plugins.*", "providers", "providers.*"]
+include = ["agent", "agent.*", "tools", "tools.*", "hermes_cli", "hermes_cli.*", "gateway", "gateway.*", "tui_gateway", "tui_gateway.*", "cron", "acp_adapter", "plugins", "plugins.*", "providers", "providers.*"]
 
 [tool.pytest.ini_options]
 testpaths = ["tests"]
