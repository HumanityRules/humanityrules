+# DOH: /__doh_broker/* → 127.0.0.1:9951 (the integrations broker's control API).
+def _doh_broker_proxy(handler, parsed, method: str, body: bytes) -> bool:
+    import http.client as _httpclient
 
+    upstream_path = parsed.path[len("/__doh_broker"):] or "/"
+    if parsed.query:
+        upstream_path += "?" + parsed.query
+    try:
+        conn = _httpclient.HTTPConnection("127.0.0.1", 9951, timeout=10)
+        conn.request(method, upstream_path, body=body, headers={"Content-Type": "application/json"})
+        resp = conn.getresponse()
+        payload = resp.read()
+        status = resp.status
+        ctype = resp.getheader("Content-Type") or "application/json"
+        conn.close()
+    except Exception as exc:
+        payload = json.dumps({"error": f"broker unreachable: {exc}"}).encode()
+        status = 502
+        ctype = "application/json"
+    handler.send_response(status)
+    handler.send_header("Content-Type", ctype)
+    handler.send_header("Content-Length", str(len(payload)))
+    handler.send_header("Cache-Control", "no-store")
+    handler.end_headers()
+    handler.wfile.write(payload)
+    return True
+
+
+# DOH: /__mcp_aggregator/* → 127.0.0.1:9952 (MCP aggregator OAuth + control).
+def _doh_mcp_aggregator_proxy(handler, parsed, method: str, body: bytes) -> bool:
+    import http.client as _httpclient
+
+    upstream_path = parsed.path[len("/__mcp_aggregator"):] or "/"
+    if parsed.query:
+        upstream_path += "?" + parsed.query
+    try:
+        conn = _httpclient.HTTPConnection("127.0.0.1", 9952, timeout=30)
+        conn.request(method, upstream_path, body=body, headers={"Content-Type": handler.headers.get("Content-Type", "application/json")})
+        resp = conn.getresponse()
+        payload = resp.read()
+        status = resp.status
+        ctype = resp.getheader("Content-Type") or "application/json"
+        location = resp.getheader("Location")
+        conn.close()
+    except Exception as exc:
+        payload = json.dumps({"error": f"mcp aggregator unreachable: {exc}"}).encode()
+        status = 502
+        ctype = "application/json"
+        location = None
+    handler.send_response(status)
+    handler.send_header("Content-Type", ctype)
+    handler.send_header("Content-Length", str(len(payload)))
+    if location:
+        handler.send_header("Location", location)
+    handler.send_header("Cache-Control", "no-store")
+    handler.end_headers()
+    handler.wfile.write(payload)
+    return True
+
