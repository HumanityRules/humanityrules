+
+# DOH: /__doh_broker/* → 127.0.0.1:9951 (the integrations broker's unified
+# control API: TLS-intercept providers like Google plus MCP-aggregator
+# providers like Notion). The aggregator's port 9952 is sandbox-only MCP
+# transport and is never reached by the browser.
+def _doh_broker_proxy(handler, parsed, method: str, body: bytes) -> bool:
+    import http.client as _httpclient
+
+    upstream_path = parsed.path[len("/__doh_broker"):] or "/"
+    if parsed.query:
+        upstream_path += "?" + parsed.query
+    try:
+        conn = _httpclient.HTTPConnection("127.0.0.1", 9951, timeout=30)
+        upstream_headers = {"Content-Type": handler.headers.get("Content-Type", "application/json")}
+        conn.request(method, upstream_path, body=body, headers=upstream_headers)
+        resp = conn.getresponse()
+        payload = resp.read()
+        status = resp.status
+        ctype = resp.getheader("Content-Type") or "application/json"
+        location = resp.getheader("Location")
+        conn.close()
+    except Exception as exc:
+        payload = json.dumps({"error": f"broker unreachable: {exc}"}).encode()
+        status = 502
+        ctype = "application/json"
+        location = None
+    handler.send_response(status)
+    handler.send_header("Content-Type", ctype)
+    handler.send_header("Content-Length", str(len(payload)))
+    if location:
+        handler.send_header("Location", location)
+    handler.send_header("Cache-Control", "no-store")
+    handler.end_headers()
+    handler.wfile.write(payload)
+    return True

