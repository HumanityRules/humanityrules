From: DevOps Hero <doh@devopshero.ai>
Subject: [PATCH] Bedrock TTFT perf telemetry over SSE `perf` event

Pinned upstream: hermes-webui 0.51.34.

Purpose: surface end-to-end and per-segment latency for Bedrock chat turns
to the browser console so we can see whether sluggishness is Bedrock TTFT
or our own pre-Bedrock work. One-shot `perf` SSE event per turn, gated on
provider == 'bedrock'. No UI, no server-side log.

Segments (all in ms, monotonic on their origin host):

  our_stack_ms        — /api/chat/start received → converse_stream() called
  bedrock_ttft_ms     — converse_stream() called → first Bedrock delta
  callback_to_sse_ms  — first Bedrock delta → first `token` on SSE queue

The browser (`static/messages.js`) adds two more numbers for the full
picture:

  post_rtt_ms       — Enter → /api/chat/start POST responded
  browser_ttft_ms   — Enter → first `token` rendered in the chat

The backend timestamps are stashed on the AIAgent instance by
`patches/05-bedrock-ttft-perf.patch`. This patch reads them on first
on_token() and clears them after emission so reused agents (the
SESSION_AGENT_CACHE path) don't report stale numbers on a later turn that
didn't actually hit Bedrock (e.g. tool-only loops).

Upstream status: DOH-specific; no plan to upstream. Revisit if upstream
adds a first-class TTFT metric in api/metering.py.

--- a/api/routes.py
+++ b/api/routes.py
@@ -6480,6 +6480,10 @@
     s.workspace = workspace
     s.model = model
     s.model_provider = model_provider
+    # DOH TTFT telemetry: monotonic stamp of when this POST was parsed.
+    # Streaming thread reads it off the session to compute our_stack_ms.
+    # Wall-clock `pending_started_at` is kept for existing callers.
+    s.pending_started_at_mono = time.monotonic()
     s.active_stream_id = stream_id
     s.pending_user_message = msg
     s.pending_attachments = attachments
--- a/api/streaming.py
+++ b/api/streaming.py
@@ -2169,6 +2169,40 @@
                 stats.setdefault('tps_available', False)
                 stats.setdefault('estimated', False)
                 put('metering', stats)
+
+            # DOH TTFT telemetry (bedrock only). Emitted once per turn on the
+            # first on_token. `agent` and `s` are bound in the enclosing scope
+            # by the time tokens arrive (agent is built later in the function;
+            # tokens only flow once agent.run_conversation() is called below).
+            _perf_emitted = [False]
+
+            def _maybe_emit_bedrock_perf():
+                if _perf_emitted[0]:
+                    return
+                _perf_emitted[0] = True  # run exactly once per turn
+                if (resolved_provider or '').lower() != 'bedrock':
+                    return
+                try:
+                    _send_at = getattr(agent, '_perf_bedrock_send_at', None)
+                    _first_at = getattr(agent, '_perf_bedrock_first_delta_at', None)
+                    _arrived_at = getattr(s, 'pending_started_at_mono', None)
+                    if _send_at is None or _first_at is None:
+                        return  # agent patch not applied or not a bedrock call
+                    payload = {
+                        'bedrock_ttft_ms': round((_first_at - _send_at) * 1000, 1),
+                        'callback_to_sse_ms': round((time.monotonic() - _first_at) * 1000, 1),
+                    }
+                    if _arrived_at is not None:
+                        payload['our_stack_ms'] = round((_send_at - _arrived_at) * 1000, 1)
+                    put('perf', payload)
+                finally:
+                    # Clear so a cached agent's next turn can't replay these
+                    # numbers if it happens to skip Bedrock (tool-only loop).
+                    for _attr in ('_perf_bedrock_send_at', '_perf_bedrock_first_delta_at'):
+                        try:
+                            delattr(agent, _attr)
+                        except Exception:
+                            pass

             def on_token(text):
                 nonlocal _token_sent
@@ -2179,6 +2213,7 @@
                 if stream_id in STREAM_PARTIAL_TEXT:
                     STREAM_PARTIAL_TEXT[stream_id] += str(text)
                 put('token', {'text': text})
+                _maybe_emit_bedrock_perf()
                 # Update live throughput from stream delta callbacks, not from
                 # byte/character length. If a backend cannot provide live deltas,
                 # the frontend hides TPS rather than showing an estimate.
--- a/static/messages.js
+++ b/static/messages.js
@@ -208,0 +209,6 @@
+  // DOH TTFT telemetry: stamp Enter so we can compute browser_ttft_ms and
+  // post_rtt_ms. performance.now() is monotonic, unaffected by clock skew.
+  // _dohPerfPostRttMs is hoisted (let, not const) because it's assigned
+  // inside the try{} around /api/chat/start but read after the try/catch.
+  const _dohPerfEnterTs=(typeof performance!=='undefined'&&performance.now)?performance.now():Date.now();
+  let _dohPerfPostRttMs=0;
@@ -262,0 +269,3 @@
+    const _dohPerfPostTs=(typeof performance!=='undefined'&&performance.now)?performance.now():Date.now();
+    _dohPerfPostRttMs=_dohPerfPostTs-_dohPerfEnterTs;
+
@@ -337,2 +346,3 @@
-  // Open SSE stream and render tokens live
-  attachLiveStream(activeSid, streamId, uploadedNames);
+  // Open SSE stream and render tokens live. Pass TTFT anchors so the
+  // first-token handler can compute browser_ttft_ms.
+  attachLiveStream(activeSid, streamId, uploadedNames, {_dohPerfEnterTs, _dohPerfPostRttMs});
@@ -760,0 +771,11 @@
+
+    // DOH TTFT telemetry: remember Enter + post-RTT stamps passed by send().
+    // First `token` event prints once, then silences. The `perf` SSE event
+    // (bedrock only) delivers the backend's three monotonic measurements;
+    // they may arrive just before or just after the first token depending
+    // on callback ordering, so we print the browser-side numbers on first
+    // token with whatever backend payload has landed by then.
+    const _dohPerfEnterTs=options&&options._dohPerfEnterTs;
+    const _dohPerfPostRttMs=options&&options._dohPerfPostRttMs;
+    let _dohPerfTokenLogged=false;
+    let _dohPerfBackend=null;
@@ -765,0 +787,11 @@
+      if(!_dohPerfTokenLogged&&typeof _dohPerfEnterTs==='number'){
+        _dohPerfTokenLogged=true;
+        const _now=(typeof performance!=='undefined'&&performance.now)?performance.now():Date.now();
+        const _browserTtftMs=_now-_dohPerfEnterTs;
+        console.log('[doh-perf bedrock]',{
+          post_rtt_ms: Math.round(_dohPerfPostRttMs||0),
+          browser_ttft_ms: Math.round(_browserTtftMs),
+          backend: _dohPerfBackend||'(pending — may arrive in a separate `perf` event)',
+          stream_id: streamId,
+        });
+      }
@@ -1190,0 +1223,8 @@
+    });
+
+    source.addEventListener('perf',e=>{
+      // DOH TTFT backend payload (bedrock only). Arrives once per turn.
+      try{
+        _dohPerfBackend=JSON.parse(e.data||'{}');
+        console.log('[doh-perf bedrock backend]',_dohPerfBackend);
