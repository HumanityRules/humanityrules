# Hermes Agent — Environment Variables
# Copy to .env and fill in values for local development.
# In HUMR deployments, these are injected via DeploymentBlueprint env vars and secrets.

# ── WebUI ───────────────────────────────────────────────
# Password for the Hermes WebUI. Leave unset in HUMR policy-proxy-gated
# deployments (the policy proxy enforces SSO + ABAC). Set a value for local
# dev or for deployments that expose the WebUI directly (e.g. the Slack
# template).
# HERMES_WEBUI_PASSWORD=your-password-here
# Skip the first-run onboarding wizard (requires chat_ready=True)
HERMES_WEBUI_SKIP_ONBOARDING=1

# ── Model Preset ────────────────────────────────────────
# HUMR-owned preset expanded into concrete main and auxiliary model settings
# by the container supervisor. Supported values: codex, bedrock.
HUMR_LLM_PRESET=bedrock

# AWS Bedrock (required when HUMR_LLM_PRESET=bedrock)
# Credentials come from the ECS task role (no static keys); only the region
# needs to be provided.
AWS_BEDROCK_REGION=us-east-1

# OpenRouter (recommended — single key, access to 200+ models)
OPENROUTER_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# ── Web Search ──────────────────────────────────────────
# Tavily API key for AI-native web search. Get one at https://app.tavily.com/
TAVILY_API_KEY=

# ── Slack Integration (optional) ───────────────────────
# Hermes auto-enables Slack when these tokens are present.
# Leave UNSET (not empty, not fake) to disable Slack entirely.
# SLACK_APP_TOKEN=xapp-your-app-token
# SLACK_BOT_TOKEN=xoxb-your-bot-token
