# Hermes Agent — Environment Variables
# Copy to .env and fill in values for local development.
# In DOH deployments, these are injected via DeploymentBlueprint env vars and secrets.

# ── WebUI ───────────────────────────────────────────────
# Password for the Hermes WebUI. Leave unset in DOH sidecar-gated
# deployments (the sidecar enforces SSO + ABAC). Set a value for local dev
# or for deployments that expose the WebUI directly (e.g. the Slack template).
# HERMES_WEBUI_PASSWORD=your-password-here
# Bind address for the WebUI. Default in the upstream image is 0.0.0.0;
# DOH sidecar-gated deployments pin it to 127.0.0.1 so only the sidecar
# (sharing the task network namespace) can reach it.
# HERMES_WEBUI_HOST=127.0.0.1
# Skip the first-run onboarding wizard (requires chat_ready=True)
HERMES_WEBUI_SKIP_ONBOARDING=1

# ── Model Provider ──────────────────────────────────────
# Hermes provider name: bedrock, custom, anthropic, or openrouter.
# These are DOH-specific vars — the entrypoint writes them into Hermes config.yaml.
# For bedrock, DOH_LLM_BASE_URL is auto-derived from AWS_BEDROCK_REGION and can
# be left blank.
DOH_LLM_PROVIDER=bedrock
DOH_LLM_MODEL=us.anthropic.claude-opus-4-6-v1
DOH_LLM_BASE_URL=

# AWS Bedrock (required when DOH_LLM_PROVIDER=bedrock)
# The entrypoint bridges these to the boto3 standard names
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY / AWS_REGION).
AWS_BEDROCK_ACCESS_KEY_ID=
AWS_BEDROCK_SECRET_ACCESS_KEY=
AWS_BEDROCK_REGION=us-east-1

# OpenRouter (recommended — single key, access to 200+ models)
OPENROUTER_API_KEY=

# Anthropic (Claude)
ANTHROPIC_API_KEY=

# OpenAI
OPENAI_API_KEY=

# ── Web Search ──────────────────────────────────────────
# Tavily API key for AI-native web search. Get one at https://app.tavily.com/
TAVILY_API_KEY=

# ── Slack Integration (optional) ───────────────────────
# Hermes auto-enables Slack when these tokens are present.
# Leave UNSET (not empty, not fake) to disable Slack entirely.
# SLACK_APP_TOKEN=xapp-your-app-token
# SLACK_BOT_TOKEN=xoxb-your-bot-token
