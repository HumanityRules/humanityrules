{
  "extends": "default",
  "meta": {
    "name": "hermes-nono",
    "description": "Hermes WebUI with local AWS broker access"
  },
  "workdir": {
    "access": "readwrite"
  },
  "environment": {
    "allow_vars": [
      "DOH_BIN_DIR",
      "DOH_ROOT",
      "DOH_RUN_DIR",
      "DOH_RUNTIME_DIR",
      "HERMES_HOME",
      "HERMES_WEBUI_AGENT_DIR",
      "HERMES_WEBUI_DIR",
      "HERMES_WEBUI_PYTHON",
      "HERMES_WEBUI_STATE_DIR",
      "HERMES_WEBUI_DEFAULT_WORKSPACE",
      "HERMES_WEBUI_SKIP_ONBOARDING",
      "HERMES_WEBUI_HOST",
      "HERMES_WEBUI_PORT",
      "HERMES_WEBUI_PASSWORD",
      "HERMES_WEBUI_EXTENSION_DIR",
      "HERMES_WEBUI_EXTENSION_SCRIPT_URLS",
      "HERMES_WEBUI_EXTENSION_STYLESHEET_URLS",
      "LANG",
      "LC_*",
      "TERM",
      "USER"
    ]
  },
  "filesystem": {
    "allow": [
      "/etc",
      "/run",
      "/tmp",
      "/usr",
      "/var",
      "/workspace"
    ],
    "read": [
      "/opt/doh",
      "/opt/hermes",
      "/run/doh/integrations-broker/ca"
    ],
    "read_file": [
      "/opt/doh/runtime/webui.sh",
      "/opt/doh/bin/aws",
      "/opt/doh/bin/gws",
      "/.within_container",
      "/etc/passwd",
      "/etc/group",
      "/etc/nsswitch.conf"
    ]
  },
  "network": {
    "network_profile": null,
    "block": true,
    "connect_port": [
      443
    ],
    "listen_port": [
      8787
    ],
    "open_port": [
      8787,
      9901,
      9902,
      9903,
      9950,
      9951
    ]
  }
}
