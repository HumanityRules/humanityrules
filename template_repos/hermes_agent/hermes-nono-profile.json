{
  "extends": "default",
  "meta": {
    "name": "hermes-nono",
    "description": "Hermes WebUI with local AWS broker access"
  },
  "workdir": {
    "access": "readwrite"
  },
  "environment": {
    "allow_vars": [
      "HERMES_HOME",
      "HERMES_WEBUI_AGENT_DIR",
      "HERMES_WEBUI_STATE_DIR",
      "HERMES_WEBUI_DEFAULT_WORKSPACE",
      "HERMES_WEBUI_SKIP_ONBOARDING",
      "HERMES_WEBUI_HOST",
      "HERMES_WEBUI_PORT",
      "HERMES_WEBUI_PASSWORD",
      "LANG",
      "LC_*",
      "TERM",
      "USER"
    ]
  },
  "filesystem": {
    "allow": [
      "$HOME/.hermes",
      "/workspace",
      "/tmp"
    ],
    "read": [
      "/app",
      "/usr/local/aws-cli"
    ],
    "read_file": [
      "/webui.sh",
      "/usr/local/bin/aws",
      "/usr/local/bin/gws",
      "/.within_container",
      "/etc/passwd",
      "/etc/group",
      "/etc/nsswitch.conf",
      "/home/hermeswebui/.doh/credentials/google_access_token"
    ]
  },
  "network": {
    "network_profile": "developer",
    "allow_domain": [
      "api.tavily.com",
      "www.googleapis.com",
      "gmail.googleapis.com",
      "calendar-json.googleapis.com",
      "drive.googleapis.com",
      "docs.googleapis.com",
      "sheets.googleapis.com",
      "people.googleapis.com"
    ],
    "listen_port": [
      8787
    ],
    "open_port": [
      8787,
      9901,
      9902,
      9903
    ]
  }
}
