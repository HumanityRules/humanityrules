{
  "extends": "default",
  "meta": {
    "name": "hermes-nono",
    "description": "Hermes WebUI with local AWS broker access"
  },
  "workdir": {
    "access": "readwrite"
  },
  "environment": {
    "allow_vars": [
      "HERMES_HOME",
      "HERMES_WEBUI_AGENT_DIR",
      "HERMES_WEBUI_STATE_DIR",
      "HERMES_WEBUI_DEFAULT_WORKSPACE",
      "HERMES_WEBUI_SKIP_ONBOARDING",
      "HERMES_WEBUI_HOST",
      "HERMES_WEBUI_PORT",
      "HERMES_WEBUI_PASSWORD",
      "HERMES_WEBUI_EXTENSION_DIR",
      "HERMES_WEBUI_EXTENSION_SCRIPT_URLS",
      "HERMES_WEBUI_EXTENSION_STYLESHEET_URLS",
      "LANG",
      "LC_*",
      "TERM",
      "USER"
    ]
  },
  "filesystem": {
    "allow": [
      "/app",
      "/etc",
      "/home/hermeswebui/.hermes",
      "/opt",
      "/run",
      "/tmp",
      "/usr",
      "/var",
      "/workspace"
    ],
    "read": [
      "/app",
      "/usr/local/aws-cli",
      "/opt/doh/ca",
      "/opt/doh/webui-extension"
    ],
    "read_file": [
      "/webui.sh",
      "/usr/local/bin/aws",
      "/usr/local/bin/gws",
      "/.within_container",
      "/etc/passwd",
      "/etc/group",
      "/etc/nsswitch.conf"
    ]
  },
  "network": {
    "network_profile": null,
    "block": true,
    "connect_port": [
      443
    ],
    "listen_port": [
      8787
    ],
    "open_port": [
      8787,
      9901,
      9902,
      9903,
      9950,
      9951
    ]
  }
}
