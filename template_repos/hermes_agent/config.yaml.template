# Hermes Agent — HUMR nono prototype configuration

model:
  default: __MODEL__
  provider: __CONFIG_PROVIDER__
  base_url: __BASE_URL__
__PROVIDERS_BLOCK__
fallback_providers: []
credential_pool_strategies: {}

toolsets:
- hermes-cli

agent:
  max_turns: 100
  gateway_timeout: 1800
  restart_drain_timeout: 60
  service_tier: ''
  tool_use_enforcement: auto
  gateway_timeout_warning: 900
  gateway_notify_interval: 600
  verbose: false
  reasoning_effort: medium
  personalities:
    helpful: You are a helpful, friendly AI assistant.
    concise: You are a concise assistant. Keep responses brief and to the point.
    technical: You are a technical expert. Provide detailed, accurate technical information.

terminal:
  backend: local
  modal_mode: auto
  timeout: 180
  env_passthrough: []
  persistent_shell: true
  docker_image: ''
  docker_mount_cwd_to_workspace: false
  docker_volumes: []
  container_persistent: false

browser:
  inactivity_timeout: 120
  command_timeout: 30
  record_sessions: false
  allow_private_urls: true
  # cloud_provider intentionally omitted: with no value, the agent auto-detects a
  # cloud browser from connected credentials (e.g. BROWSER_USE_API_KEY injected by
  # the browseruse connector) and uses the local browser otherwise. Pinning a
  # value here disables that auto-detect

checkpoints:
  enabled: true
  max_snapshots: 50

file_read_max_chars: 100000

compression:
  enabled: true
  threshold: 0.7
  target_ratio: 0.2
  protect_last_n: 20
  summary_provider: auto
  summary_base_url: null

smart_model_routing:
  enabled: false

auxiliary:
  vision:
    provider: __AUX_PROVIDER__
    model: __AUX_MODEL__
    base_url: '__AUX_BASE_URL__'
    api_key: ''
    timeout: 30
    download_timeout: 30
  web_extract:
    provider: __AUX_PROVIDER__
    model: __AUX_MODEL__
    base_url: '__AUX_BASE_URL__'
    api_key: ''
    timeout: 30
  compression:
    provider: __AUX_PROVIDER__
    model: __AUX_MODEL__
    base_url: '__AUX_BASE_URL__'
    api_key: ''
    timeout: 120
  skills_hub:
    provider: __AUX_PROVIDER__
    model: __AUX_MODEL__
    base_url: '__AUX_BASE_URL__'
    api_key: ''
    timeout: 30
  approval:
    provider: __AUX_PROVIDER__
    model: __AUX_MODEL__
    base_url: '__AUX_BASE_URL__'
    api_key: ''
    timeout: 30
  mcp:
    provider: __AUX_PROVIDER__
    model: __AUX_MODEL__
    base_url: '__AUX_BASE_URL__'
    api_key: ''
    timeout: 30
  title_generation:
    provider: __AUX_PROVIDER__
    model: __AUX_MODEL__
    base_url: '__AUX_BASE_URL__'
    api_key: ''
    timeout: 30
  memory_query_rewrite:
    provider: __AUX_PROVIDER__
    model: __AUX_MODEL__
    base_url: '__AUX_BASE_URL__'
    api_key: ''
    timeout: 8
  tts_audio_tags:
    provider: __AUX_PROVIDER__
    model: __AUX_MODEL__
    base_url: '__AUX_BASE_URL__'
    api_key: ''
    timeout: 30
  triage_specifier:
    provider: __AUX_PROVIDER__
    model: __AUX_MODEL__
    base_url: '__AUX_BASE_URL__'
    api_key: ''
    timeout: 120
  profile_describer:
    provider: __AUX_PROVIDER__
    model: __AUX_MODEL__
    base_url: '__AUX_BASE_URL__'
    api_key: ''
    timeout: 60
  monitor:
    provider: __AUX_PROVIDER__
    model: __AUX_MODEL__
    base_url: '__AUX_BASE_URL__'
    api_key: ''
    timeout: 60
  moa_reference:
    provider: __AUX_PROVIDER__
    model: __AUX_MODEL__
    base_url: '__AUX_BASE_URL__'
    api_key: ''
    timeout: 900
  goal_judge:
    provider: __AUX_PROVIDER__
    model: __AUX_MODEL__
    base_url: '__AUX_BASE_URL__'
    api_key: ''
    timeout: 30
    max_tokens: 4096

  # Higher-judgment auxiliary tasks stay on the main model.
  kanban_decomposer:
    provider: __CONFIG_PROVIDER__
    model: __MODEL__
    base_url: '__BASE_URL__'
    api_key: ''
    timeout: 180
  curator:
    provider: __CONFIG_PROVIDER__
    model: __MODEL__
    base_url: '__BASE_URL__'
    api_key: ''
    timeout: 600
  background_review:
    provider: __CONFIG_PROVIDER__
    model: __MODEL__
    base_url: '__BASE_URL__'
    api_key: ''
    timeout: 120
  moa_aggregator:
    provider: __CONFIG_PROVIDER__
    model: __MODEL__
    base_url: '__BASE_URL__'
    api_key: ''
    timeout: 900

display:
  compact: false
  personality: helpful
  resume_display: full
  bell_on_complete: false
  show_reasoning: false
  streaming: true
  inline_diffs: true
  show_cost: false
  skin: default
  interim_assistant_messages: true

privacy:
  redact_pii: false

context:
  engine: compressor

memory:
  memory_enabled: true
  user_profile_enabled: true
  memory_char_limit: 2200
  user_char_limit: 1375
  provider: ''
  nudge_interval: 10
  flush_min_turns: 6

delegation:
  model: ''
  provider: ''
  base_url: ''
  api_key: ''
  max_iterations: 50
  reasoning_effort: ''
  default_toolsets:
  - terminal
  - file
  - web

skills:
  external_dirs: []
  creation_nudge_interval: 15

discord:
  require_mention: true
  free_response_channels: ''
  allowed_channels: ''
  auto_thread: true
  reactions: true

whatsapp: {}

approvals:
  mode: off
  timeout: 60

command_allowlist: []

security:
  redact_secrets: true

cron:
  wrap_response: true

logging:
  level: INFO
  max_size_mb: 5
  backup_count: 3

session_reset:
  mode: both
  idle_minutes: 1440
  at_hour: 4

group_sessions_per_user: true

streaming:
  enabled: false

plugins:
  disabled:
  - browser/browserbase
  - browser-firecrawl
  - dashboard_auth/basic
  - dashboard_auth/nous
  - dashboard_auth/self_hosted
  - dingtalk-platform
  - discord-platform
  - email-platform
  - feishu-platform
  - google_chat-platform
  - homeassistant-platform
  - image_gen/fal
  - image_gen/krea
  - image_gen/openai
  - image_gen/openai-codex
  - image_gen/xai
  - irc-platform
  - line-platform
  - matrix-platform
  - mattermost-platform
  - ntfy-platform
  - raft-platform
  - simplex-platform
  - spotify
  - video_gen/fal
  - video_gen/xai
  - web/brave_free
  - web/exa
  - web-firecrawl
  - web/parallel
  - web/searxng
  - wecom-platform

web:
  backend: tavily

mcp_servers:
  agg:
    url: http://127.0.0.1:9952/mcp
    timeout: 120

platform_toolsets:
  cli:
  - browser
  - clarify
  - code_execution
  - cronjob
  - delegation
  - file
  - mcp
  - memory
  - session_search
  - skills
  - terminal
  - todo
  - vision
  - web
