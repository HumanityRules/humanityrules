# OpenClaw Agent — Environment Variables
# Copy to .env and fill in values for local development.
# In HUMR deployments, these are injected via DeploymentBlueprint env vars and secrets.

# ── Gateway ──────────────────────────────────────────────
# Token for authenticating with the gateway. Generate with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=your-gateway-token-here

# Log level: debug, info, warn, error
OPENCLAW_LOG_LEVEL=info

# ── Model Provider (at least one required) ───────────────
# OpenAI
OPENAI_API_KEY=sk-your-key-here
OPENCLAW_DEFAULT_MODEL=openai/gpt-5.4-nano

# Anthropic (alternative provider)
ANTHROPIC_API_KEY=


# ── Web Search ────────────────────────────────────────────
# Tavily API key for AI-native web search. Get one at https://app.tavily.com/
TAVILY_API_KEY=

# ── Slack Integration (optional) ─────────────────────────
# OpenClaw auto-enables Slack when these tokens are present.
# Leave UNSET (not empty, not fake) to disable Slack entirely.
# SLACK_APP_TOKEN=xapp-your-app-token
# SLACK_BOT_TOKEN=xoxb-your-bot-token
