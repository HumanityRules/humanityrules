# OpenClaw Agent — Environment Variables
# Copy to .env and fill in values for local development.
# In DOH deployments, these are injected via DeploymentBlueprint env vars and secrets.

# ── Gateway ──────────────────────────────────────────────
# Token for authenticating with the gateway. Generate with: openssl rand -hex 32
OPENCLAW_GATEWAY_TOKEN=your-gateway-token-here

# Log level: debug, info, warn, error
OPENCLAW_LOG_LEVEL=info

# ── Model Provider (at least one required) ───────────────
# Anthropic
ANTHROPIC_API_KEY=sk-ant-your-key-here
OPENCLAW_DEFAULT_MODEL=claude-sonnet-4-20250514

# OpenAI (alternative provider)
OPENAI_API_KEY=


# ── Web Search ────────────────────────────────────────────
# Brave Search API key. Get one at https://brave.com/search/api/
BRAVE_API_KEY=

# ── Slack Integration (optional) ─────────────────────────
# OpenClaw auto-enables Slack when these tokens are present.
# Leave UNSET (not empty, not fake) to disable Slack entirely.
# SLACK_APP_TOKEN=xapp-your-app-token
# SLACK_BOT_TOKEN=xoxb-your-bot-token
