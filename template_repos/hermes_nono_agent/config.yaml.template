# Hermes Agent — DOH nono prototype configuration

model:
  default: __MODEL__
  provider: __CONFIG_PROVIDER__
  base_url: __BASE_URL__
__PROVIDERS_BLOCK__
fallback_providers: []
credential_pool_strategies: {}

toolsets:
- hermes-cli

agent:
  max_turns: 100
  gateway_timeout: 1800
  restart_drain_timeout: 60
  service_tier: ''
  tool_use_enforcement: auto
  gateway_timeout_warning: 900
  gateway_notify_interval: 600
  verbose: false
  reasoning_effort: medium
  personalities:
    helpful: You are a helpful, friendly AI assistant.
    concise: You are a concise assistant. Keep responses brief and to the point.
    technical: You are a technical expert. Provide detailed, accurate technical information.

terminal:
  backend: local
  modal_mode: auto
  timeout: 180
  env_passthrough: []
  persistent_shell: true
  docker_image: ''
  docker_mount_cwd_to_workspace: false
  docker_volumes: []
  container_persistent: false

browser:
  inactivity_timeout: 120
  command_timeout: 30
  record_sessions: false
  allow_private_urls: false
  cloud_provider: local

checkpoints:
  enabled: true
  max_snapshots: 50

file_read_max_chars: 100000

compression:
  enabled: true
  threshold: 0.7
  target_ratio: 0.2
  protect_last_n: 20
  summary_provider: auto
  summary_base_url: null

smart_model_routing:
  enabled: false

auxiliary:
  vision:
    provider: __AUX_PROVIDER__
    model: __AUX_MODEL__
    base_url: '__AUX_BASE_URL__'
    api_key: ''
    timeout: 30
    download_timeout: 30
  web_extract:
    provider: __AUX_PROVIDER__
    model: __AUX_MODEL__
    base_url: '__AUX_BASE_URL__'
    api_key: ''
    timeout: 30
  compression:
    provider: __AUX_PROVIDER__
    model: __AUX_MODEL__
    base_url: '__AUX_BASE_URL__'
    api_key: ''
    timeout: 120
  session_search:
    provider: __AUX_PROVIDER__
    model: __AUX_MODEL__
    base_url: '__AUX_BASE_URL__'
    api_key: ''
    timeout: 30
  skills_hub:
    provider: __AUX_PROVIDER__
    model: __AUX_MODEL__
    base_url: '__AUX_BASE_URL__'
    api_key: ''
    timeout: 30
  approval:
    provider: __AUX_PROVIDER__
    model: __AUX_MODEL__
    base_url: '__AUX_BASE_URL__'
    api_key: ''
    timeout: 30
  mcp:
    provider: __AUX_PROVIDER__
    model: __AUX_MODEL__
    base_url: '__AUX_BASE_URL__'
    api_key: ''
    timeout: 30
  flush_memories:
    provider: __AUX_PROVIDER__
    model: __AUX_MODEL__
    base_url: '__AUX_BASE_URL__'
    api_key: ''
    timeout: 30
  title_generation:
    provider: __AUX_PROVIDER__
    model: __AUX_MODEL__
    base_url: '__AUX_BASE_URL__'
    api_key: ''
    timeout: 30

display:
  compact: false
  personality: helpful
  resume_display: full
  bell_on_complete: false
  show_reasoning: false
  streaming: true
  inline_diffs: true
  show_cost: false
  skin: default
  interim_assistant_messages: true

privacy:
  redact_pii: false

context:
  engine: compressor

memory:
  memory_enabled: true
  user_profile_enabled: true
  memory_char_limit: 2200
  user_char_limit: 1375
  provider: ''
  nudge_interval: 10
  flush_min_turns: 6

delegation:
  model: ''
  provider: ''
  base_url: ''
  api_key: ''
  max_iterations: 50
  reasoning_effort: ''
  default_toolsets:
  - terminal
  - file
  - web

skills:
  external_dirs: []
  creation_nudge_interval: 15

discord:
  require_mention: true
  free_response_channels: ''
  allowed_channels: ''
  auto_thread: true
  reactions: true

whatsapp: {}

approvals:
  mode: manual
  timeout: 60

command_allowlist: []

security:
  redact_secrets: true

cron:
  wrap_response: true

logging:
  level: INFO
  max_size_mb: 5
  backup_count: 3

session_reset:
  mode: both
  idle_minutes: 1440
  at_hour: 4

group_sessions_per_user: true

streaming:
  enabled: false

platform_toolsets:
  cli:
  - browser
  - clarify
  - code_execution
  - cronjob
  - delegation
  - file
  - memory
  - session_search
  - skills
  - terminal
  - todo
  - vision
  - web
