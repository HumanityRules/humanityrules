# Hermes local stack — copy to .env and adjust.
# See ../hermes_agent/.env.example for the full variable reference.

# ── WebUI ───────────────────────────────────────────────
HERMES_WEBUI_SKIP_ONBOARDING=1

# ── Bedrock (default local LLM) ─────────────────────────
HUMR_LLM_PRESET=bedrock
AWS_BEDROCK_REGION=us-east-1
AWS_PROFILE=bedrock_dev
# Comma-separated platform capabilities; CP injects this per-org on real
# deployments. bedrock-runtime is what puts the curated Bedrock models in the
# WebUI dropdown, so the bedrock preset above needs it.
HUMR_PLATFORM_CAPABILITIES=bedrock-runtime

# ── Control plane identity (app + integrations broker) ──
# Seed the DB rows first so the local stack appears as an App in HUMR:
#   uv run manage.py seed_local_app --aws-account "CH Sandbox" \
#       --app-slug <app-slug> --owner-username <username>
# Then set all four below; supervisor.sh starts the integrations broker when they
# are present, pointing at the laptop's Django over the humanityrules.ngrok.io tunnel.
# HUMR_CONTROL_PLANE_URL=https://humanityrules.ngrok.io
# HUMR_ENV_BEARER=local-dev-bearer-token
# HUMR_OWNER_USERNAME=
# HUMR_APP_SLUG=
# HUMR_ORG_SLUG=

# ── Optional ────────────────────────────────────────────
# TAVILY_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
