# Hermes local stack — copy to .env and adjust.
# See ../hermes_agent/.env.example for the full variable reference.

# ── WebUI ───────────────────────────────────────────────
HERMES_WEBUI_SKIP_ONBOARDING=1

# ── Bedrock (default local LLM) ─────────────────────────
DOH_LLM_PROVIDER=bedrock
DOH_LLM_MODEL=us.anthropic.claude-sonnet-4-6
AWS_BEDROCK_REGION=us-east-1
AWS_PROFILE=bedrock_dev

# ── Optional ────────────────────────────────────────────
# TAVILY_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
