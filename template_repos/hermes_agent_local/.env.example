# Hermes local stack — copy to .env and adjust.
# See ../hermes_agent/.env.example for the full variable reference.

# ── WebUI ───────────────────────────────────────────────
HERMES_WEBUI_SKIP_ONBOARDING=1

# ── Bedrock (default local LLM) ─────────────────────────
HUMR_LLM_PROVIDER=bedrock
HUMR_LLM_MODEL=us.anthropic.claude-sonnet-4-6
AWS_BEDROCK_REGION=us-east-1
AWS_PROFILE=bedrock_dev

# ── Integrations broker (optional; Google/GitHub via HUMR) ──
# All four must be set for supervisor.sh to start the broker. They point it at
# the laptop's Django (over the humanityrules.ngrok.io tunnel) as one existing App
# owned by one user. Seed the DB rows first:
#   uv run manage.py seed_local_integrations --aws-account "CH Sandbox" \
#       --app-slug <app-slug> --owner-username <username>
# HUMR_CONTROL_PLANE_URL=https://humanityrules.ngrok.io
# HUMR_ENV_BEARER=local-dev-bearer-token
# HUMR_OWNER_USERNAME=
# HUMR_APP_SLUG=

# ── Optional ────────────────────────────────────────────
# TAVILY_API_KEY=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
