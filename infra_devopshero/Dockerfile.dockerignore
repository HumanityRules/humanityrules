# Per-Dockerfile ignore for `infra_devopshero/Dockerfile`, picked up by BuildKit
# because of the `Dockerfile.dockerignore` filename (must sit next to the Dockerfile
# and use this exact `<dockerfile-name>.dockerignore` form). Patterns are evaluated
# relative to the build context, which is the project root (see deploy_app.sh:
# `docker build -f infra_devopshero/Dockerfile -t devopshero:latest .`).

# Git. `**/.git` (not bare `.git`, which only matches the context root) so the
# control-plane image's `COPY . .` excludes the nested submodule `.git` pointer
# files under template_repos/hermes_agent/vendor/ -- they dangle into the
# superproject's .git/modules and have no meaning inside the image.
**/.git
.gitignore
.gitattributes

# Python
__pycache__
*.pyc
*.pyo
*.pyd
.Python
.venv
venv
.pytest_cache
.mypy_cache
*.egg-info

# IDE
.vscode
.idea
*.swp
*.swo
.DS_Store

# Build artifacts
*.log
tmp/
cdk.out/
staticfiles/
node_modules/

# Development files
.env
.env.*
!.env.example
*.sqlite3
local/

# Documentation and specs
docs/
openspec/
*.md
!README.md

# Test files
tests/
*_test.py
test_*.py

# CDK infrastructure (not needed in container)
infra_devopshero/stacks/
infra_devopshero/*.sh
infra_devopshero/*.json
infra_devopshero/cdk.json
infra_devopshero/app.py

# Other
.claude/
.cursor/
.playwright-mcp/
