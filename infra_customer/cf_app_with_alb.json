{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "DevOpsHero App - ECS Service with ALB for {{ app_name }}",

  "Parameters": {
    "ImageTag": {
      "Type": "String",
      "Default": "latest",
      "Description": "Docker image tag to deploy"
    }
  },

  "Resources": {
    "TaskDefinition": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": "devopshero-{{ app_name }}",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": ["FARGATE"],
        "Cpu": "{{ cpu }}",
        "Memory": "{{ memory }}",
        "ExecutionRoleArn": { "Fn::ImportValue": "devopshero-task-execution-role-arn" },
        "TaskRoleArn": { "Fn::ImportValue": "devopshero-task-role-arn" },
        "ContainerDefinitions": [
          {
            "Name": "{{ app_name }}",
            "Image": {
              "Fn::Sub": "${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com/{{ ecr_repo_name }}:${ImageTag}"
            },
            "Essential": true,
            "PortMappings": [
              {
                "ContainerPort": {{ container_port }},
                "Protocol": "tcp"
              }
            ],
            {% if health_check_command %}
            "HealthCheck": {
              "Command": ["CMD-SHELL", {{ health_check_command | tojson }}],
              "Interval": 30,
              "Timeout": 10,
              "Retries": 3,
              "StartPeriod": 60
            },
            {% endif %}
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": { "Fn::ImportValue": "devopshero-ecs-log-group" },
                "awslogs-region": { "Ref": "AWS::Region" },
                "awslogs-stream-prefix": "{{ app_name }}"
              }
            }
            {% if environment_variables %}
            ,"Environment": [
              {% for env in environment_variables %}
              {
                "Name": "{{ env.name }}",
                "Value": "{{ env.value }}"
              }{% if not loop.last %},{% endif %}
              {% endfor %}
            ]
            {% endif %}
          }
        ],
        "Tags": [
          { "Key": "Name", "Value": "devopshero-{{ app_name }}-task" },
          { "Key": "App", "Value": "{{ app_name }}" }
        ]
      }
    },

    "AlbSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupName": "devopshero-{{ app_name }}-alb-sg",
        "GroupDescription": "Security group for ALB - allows HTTP from internet",
        "VpcId": { "Fn::ImportValue": "devopshero-vpc-id" },
        "SecurityGroupIngress": [
          {
            "Description": "Allow HTTP from anywhere",
            "IpProtocol": "tcp",
            "FromPort": 80,
            "ToPort": 80,
            "CidrIp": "0.0.0.0/0"
          }
        ],
        "SecurityGroupEgress": [
          {
            "Description": "Allow all outbound traffic",
            "IpProtocol": "-1",
            "CidrIp": "0.0.0.0/0"
          }
        ],
        "Tags": [
          { "Key": "Name", "Value": "devopshero-{{ app_name }}-alb-sg" }
        ]
      }
    },

    "ApplicationLoadBalancer": {
      "Type": "AWS::ElasticLoadBalancingV2::LoadBalancer",
      "Properties": {
        "Name": "devopshero-{{ app_name }}-alb",
        "Type": "application",
        "Scheme": "internet-facing",
        "IpAddressType": "ipv4",
        "Subnets": [
          { "Fn::ImportValue": "devopshero-public-subnet-1" },
          { "Fn::ImportValue": "devopshero-public-subnet-2" }
        ],
        "SecurityGroups": [
          { "Ref": "AlbSecurityGroup" }
        ],
        "Tags": [
          { "Key": "Name", "Value": "devopshero-{{ app_name }}-alb" }
        ]
      }
    },

    "TargetGroup": {
      "Type": "AWS::ElasticLoadBalancingV2::TargetGroup",
      "Properties": {
        "Name": "devopshero-{{ app_name }}-tg",
        "VpcId": { "Fn::ImportValue": "devopshero-vpc-id" },
        "Protocol": "HTTP",
        "Port": {{ container_port }},
        "TargetType": "ip",
        "HealthCheckEnabled": true,
        "HealthCheckPath": "{{ health_check_path }}",
        "HealthCheckProtocol": "HTTP",
        "HealthCheckIntervalSeconds": 30,
        "HealthCheckTimeoutSeconds": 10,
        "HealthyThresholdCount": 2,
        "UnhealthyThresholdCount": 3,
        "Matcher": {
          "HttpCode": "200"
        },
        "Tags": [
          { "Key": "Name", "Value": "devopshero-{{ app_name }}-tg" }
        ]
      }
    },

    "HttpListener": {
      "Type": "AWS::ElasticLoadBalancingV2::Listener",
      "Properties": {
        "LoadBalancerArn": { "Ref": "ApplicationLoadBalancer" },
        "Port": 80,
        "Protocol": "HTTP",
        "DefaultActions": [
          {
            "Type": "forward",
            "TargetGroupArn": { "Ref": "TargetGroup" }
          }
        ]
      }
    },

    "EcsService": {
      "Type": "AWS::ECS::Service",
      "DependsOn": "HttpListener",
      "Properties": {
        "ServiceName": "{{ app_name }}",
        "Cluster": { "Fn::ImportValue": "devopshero-cluster-arn" },
        "TaskDefinition": { "Ref": "TaskDefinition" },
        "DesiredCount": 0,
        "LaunchType": "FARGATE",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "AssignPublicIp": "DISABLED",
            "Subnets": [
              { "Fn::ImportValue": "devopshero-private-subnet-1" },
              { "Fn::ImportValue": "devopshero-private-subnet-2" }
            ],
            "SecurityGroups": [
              { "Fn::ImportValue": "devopshero-default-sg-id" }
            ]
          }
        },
        "LoadBalancers": [
          {
            "TargetGroupArn": { "Ref": "TargetGroup" },
            "ContainerName": "{{ app_name }}",
            "ContainerPort": {{ container_port }}
          }
        ],
        "DeploymentConfiguration": {
          "MaximumPercent": 200,
          "MinimumHealthyPercent": 100
        },
        "EnableExecuteCommand": true,
        "Tags": [
          { "Key": "Name", "Value": "devopshero-{{ app_name }}-service" },
          { "Key": "App", "Value": "{{ app_name }}" }
        ]
      }
    }
  },

  "Outputs": {
    "TaskDefinitionArn": {
      "Description": "ECS Task Definition ARN",
      "Value": { "Ref": "TaskDefinition" },
      "Export": { "Name": "devopshero-{{ app_name }}-task-def-arn" }
    },
    "AlbDnsName": {
      "Description": "ALB DNS Name - use this to access the app",
      "Value": { "Fn::GetAtt": ["ApplicationLoadBalancer", "DNSName"] },
      "Export": { "Name": "devopshero-{{ app_name }}-alb-dns" }
    },
    "AlbUrl": {
      "Description": "Full URL to access the app",
      "Value": { "Fn::Sub": "http://${ApplicationLoadBalancer.DNSName}" },
      "Export": { "Name": "devopshero-{{ app_name }}-alb-url" }
    },
    "AlbArn": {
      "Description": "ALB ARN",
      "Value": { "Ref": "ApplicationLoadBalancer" },
      "Export": { "Name": "devopshero-{{ app_name }}-alb-arn" }
    },
    "TargetGroupArn": {
      "Description": "Target Group ARN",
      "Value": { "Ref": "TargetGroup" },
      "Export": { "Name": "devopshero-{{ app_name }}-tg-arn" }
    },
    "ServiceArn": {
      "Description": "ECS Service ARN",
      "Value": { "Ref": "EcsService" },
      "Export": { "Name": "devopshero-{{ app_name }}-service-arn" }
    },
    "ServiceName": {
      "Description": "ECS Service Name",
      "Value": "{{ app_name }}",
      "Export": { "Name": "devopshero-{{ app_name }}-service-name" }
    }
  }
}
