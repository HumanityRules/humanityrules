{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "DevOpsHero App - Deploy ECR and Task Definition for {{ app_name }}",

  "Parameters": {
    "ImageTag": {
      "Type": "String",
      "Default": "latest",
      "Description": "Docker image tag to deploy"
    }
  },

  "Resources": {
    "EcrRepository": {
      "Type": "AWS::ECR::Repository",
      "Properties": {
        "RepositoryName": "{{ ecr_repo_name }}",
        "ImageScanningConfiguration": {
          "ScanOnPush": true
        },
        "LifecyclePolicy": {
          "LifecyclePolicyText": "{\"rules\":[{\"rulePriority\":1,\"description\":\"Keep last 10 images\",\"selection\":{\"tagStatus\":\"any\",\"countType\":\"imageCountMoreThan\",\"countNumber\":10},\"action\":{\"type\":\"expire\"}}]}"
        },
        "Tags": [
          { "Key": "Name", "Value": "devopshero-{{ app_name }}" },
          { "Key": "App", "Value": "{{ app_name }}" }
        ]
      }
    },

    "TaskDefinition": {
      "Type": "AWS::ECS::TaskDefinition",
      "Properties": {
        "Family": "devopshero-{{ app_name }}",
        "NetworkMode": "awsvpc",
        "RequiresCompatibilities": ["FARGATE"],
        "Cpu": "{{ cpu }}",
        "Memory": "{{ memory }}",
        "ExecutionRoleArn": { "Fn::ImportValue": "devopshero-task-execution-role-arn" },
        "TaskRoleArn": { "Fn::ImportValue": "devopshero-task-role-arn" },
        "ContainerDefinitions": [
          {
            "Name": "{{ app_name }}",
            "Image": {
              "Fn::Sub": "${AWS::AccountId}.dkr.ecr.${AWS::Region}.amazonaws.com/{{ ecr_repo_name }}:${ImageTag}"
            },
            "Essential": true,
            "PortMappings": [
              {
                "ContainerPort": {{ container_port }},
                "Protocol": "tcp"
              }
            ],
            {% if health_check_command %}
            "HealthCheck": {
              "Command": ["CMD-SHELL", "{{ health_check_command }}"],
              "Interval": 30,
              "Timeout": 10,
              "Retries": 3,
              "StartPeriod": 60
            },
            {% endif %}
            "LogConfiguration": {
              "LogDriver": "awslogs",
              "Options": {
                "awslogs-group": { "Fn::ImportValue": "devopshero-ecs-log-group" },
                "awslogs-region": { "Ref": "AWS::Region" },
                "awslogs-stream-prefix": "{{ app_name }}"
              }
            }
            {% if environment_variables %}
            ,"Environment": [
              {% for env in environment_variables %}
              {
                "Name": "{{ env.name }}",
                "Value": "{{ env.value }}"
              }{% if not loop.last %},{% endif %}
              {% endfor %}
            ]
            {% endif %}
          }
        ],
        "Tags": [
          { "Key": "Name", "Value": "devopshero-{{ app_name }}-task" },
          { "Key": "App", "Value": "{{ app_name }}" }
        ]
      }
    }
  },

  "Outputs": {
    "EcrRepositoryUri": {
      "Description": "ECR Repository URI",
      "Value": { "Fn::GetAtt": ["EcrRepository", "RepositoryUri"] },
      "Export": { "Name": "devopshero-{{ app_name }}-ecr-uri" }
    },
    "EcrRepositoryArn": {
      "Description": "ECR Repository ARN",
      "Value": { "Fn::GetAtt": ["EcrRepository", "Arn"] },
      "Export": { "Name": "devopshero-{{ app_name }}-ecr-arn" }
    },
    "TaskDefinitionArn": {
      "Description": "ECS Task Definition ARN",
      "Value": { "Ref": "TaskDefinition" },
      "Export": { "Name": "devopshero-{{ app_name }}-task-def-arn" }
    }
  }
}

