{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "DevOpsHero VPC - Public subnets for NAT Gateway, private subnets for Fargate tasks",

  "Parameters": {
    "VpcCidr": {
      "Type": "String",
      "Default": "172.20.0.0/20",
      "Description": "CIDR block for the VPC (uses 172.16-31.x.x range to avoid conflicts)"
    },
    "PublicSubnet1Cidr": {
      "Type": "String",
      "Default": "172.20.0.0/24",
      "Description": "CIDR block for public subnet 1 (NAT Gateway)"
    },
    "PublicSubnet2Cidr": {
      "Type": "String",
      "Default": "172.20.1.0/24",
      "Description": "CIDR block for public subnet 2"
    },
    "PrivateSubnet1Cidr": {
      "Type": "String",
      "Default": "172.20.2.0/24",
      "Description": "CIDR block for private subnet 1 (Fargate tasks)"
    },
    "PrivateSubnet2Cidr": {
      "Type": "String",
      "Default": "172.20.3.0/24",
      "Description": "CIDR block for private subnet 2 (Fargate tasks)"
    }
  },

  "Resources": {
    "VPC": {
      "Type": "AWS::EC2::VPC",
      "Properties": {
        "CidrBlock": { "Ref": "VpcCidr" },
        "EnableDnsSupport": true,
        "EnableDnsHostnames": true,
        "Tags": [
          { "Key": "Name", "Value": "devopshero-vpc" }
        ]
      }
    },

    "InternetGateway": {
      "Type": "AWS::EC2::InternetGateway",
      "Properties": {
        "Tags": [
          { "Key": "Name", "Value": "devopshero-igw" }
        ]
      }
    },

    "InternetGatewayAttachment": {
      "Type": "AWS::EC2::VPCGatewayAttachment",
      "Properties": {
        "VpcId": { "Ref": "VPC" },
        "InternetGatewayId": { "Ref": "InternetGateway" }
      }
    },

    "PublicSubnet1": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": { "Ref": "VPC" },
        "CidrBlock": { "Ref": "PublicSubnet1Cidr" },
        "AvailabilityZone": { "Fn::Select": ["0", { "Fn::GetAZs": "" }] },
        "MapPublicIpOnLaunch": true,
        "Tags": [
          { "Key": "Name", "Value": "devopshero-public-1" }
        ]
      }
    },

    "PublicSubnet2": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": { "Ref": "VPC" },
        "CidrBlock": { "Ref": "PublicSubnet2Cidr" },
        "AvailabilityZone": { "Fn::Select": ["1", { "Fn::GetAZs": "" }] },
        "MapPublicIpOnLaunch": true,
        "Tags": [
          { "Key": "Name", "Value": "devopshero-public-2" }
        ]
      }
    },

    "PrivateSubnet1": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": { "Ref": "VPC" },
        "CidrBlock": { "Ref": "PrivateSubnet1Cidr" },
        "AvailabilityZone": { "Fn::Select": ["0", { "Fn::GetAZs": "" }] },
        "Tags": [
          { "Key": "Name", "Value": "devopshero-private-1" }
        ]
      }
    },

    "PrivateSubnet2": {
      "Type": "AWS::EC2::Subnet",
      "Properties": {
        "VpcId": { "Ref": "VPC" },
        "CidrBlock": { "Ref": "PrivateSubnet2Cidr" },
        "AvailabilityZone": { "Fn::Select": ["1", { "Fn::GetAZs": "" }] },
        "Tags": [
          { "Key": "Name", "Value": "devopshero-private-2" }
        ]
      }
    },

    "NatGatewayEip": {
      "Type": "AWS::EC2::EIP",
      "DependsOn": "InternetGatewayAttachment",
      "Properties": {
        "Domain": "vpc",
        "Tags": [
          { "Key": "Name", "Value": "devopshero-nat-eip" }
        ]
      }
    },

    "NatGateway": {
      "Type": "AWS::EC2::NatGateway",
      "Properties": {
        "AllocationId": { "Fn::GetAtt": ["NatGatewayEip", "AllocationId"] },
        "SubnetId": { "Ref": "PublicSubnet1" },
        "Tags": [
          { "Key": "Name", "Value": "devopshero-nat" }
        ]
      }
    },

    "PublicRouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": { "Ref": "VPC" },
        "Tags": [
          { "Key": "Name", "Value": "devopshero-public-rt" }
        ]
      }
    },

    "PublicRoute": {
      "Type": "AWS::EC2::Route",
      "DependsOn": "InternetGatewayAttachment",
      "Properties": {
        "RouteTableId": { "Ref": "PublicRouteTable" },
        "DestinationCidrBlock": "0.0.0.0/0",
        "GatewayId": { "Ref": "InternetGateway" }
      }
    },

    "PublicSubnet1RouteTableAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": { "Ref": "PublicSubnet1" },
        "RouteTableId": { "Ref": "PublicRouteTable" }
      }
    },

    "PublicSubnet2RouteTableAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": { "Ref": "PublicSubnet2" },
        "RouteTableId": { "Ref": "PublicRouteTable" }
      }
    },

    "PrivateRouteTable": {
      "Type": "AWS::EC2::RouteTable",
      "Properties": {
        "VpcId": { "Ref": "VPC" },
        "Tags": [
          { "Key": "Name", "Value": "devopshero-private-rt" }
        ]
      }
    },

    "PrivateRoute": {
      "Type": "AWS::EC2::Route",
      "Properties": {
        "RouteTableId": { "Ref": "PrivateRouteTable" },
        "DestinationCidrBlock": "0.0.0.0/0",
        "NatGatewayId": { "Ref": "NatGateway" }
      }
    },

    "PrivateSubnet1RouteTableAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": { "Ref": "PrivateSubnet1" },
        "RouteTableId": { "Ref": "PrivateRouteTable" }
      }
    },

    "PrivateSubnet2RouteTableAssociation": {
      "Type": "AWS::EC2::SubnetRouteTableAssociation",
      "Properties": {
        "SubnetId": { "Ref": "PrivateSubnet2" },
        "RouteTableId": { "Ref": "PrivateRouteTable" }
      }
    },

    "DefaultSecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupName": "devopshero-default-sg",
        "GroupDescription": "Default security group - allows VPC inbound and all outbound",
        "VpcId": { "Ref": "VPC" },
        "SecurityGroupIngress": [
          {
            "Description": "Allow all traffic from within VPC",
            "IpProtocol": "-1",
            "CidrIp": { "Ref": "VpcCidr" }
          }
        ],
        "SecurityGroupEgress": [
          {
            "Description": "Allow all outbound traffic",
            "IpProtocol": "-1",
            "CidrIp": "0.0.0.0/0"
          }
        ],
        "Tags": [
          { "Key": "Name", "Value": "devopshero-default-sg" }
        ]
      }
    }
  },

  "Outputs": {
    "VpcId": {
      "Description": "VPC ID",
      "Value": { "Ref": "VPC" },
      "Export": { "Name": "devopshero-vpc-id" }
    },
    "VpcCidr": {
      "Description": "VPC CIDR block",
      "Value": { "Fn::GetAtt": ["VPC", "CidrBlock"] },
      "Export": { "Name": "devopshero-vpc-cidr" }
    },
    "PublicSubnet1Id": {
      "Description": "Public Subnet 1 ID",
      "Value": { "Ref": "PublicSubnet1" },
      "Export": { "Name": "devopshero-public-subnet-1" }
    },
    "PublicSubnet2Id": {
      "Description": "Public Subnet 2 ID",
      "Value": { "Ref": "PublicSubnet2" },
      "Export": { "Name": "devopshero-public-subnet-2" }
    },
    "PublicSubnetIds": {
      "Description": "Comma-separated list of public subnet IDs",
      "Value": { "Fn::Join": [",", [{ "Ref": "PublicSubnet1" }, { "Ref": "PublicSubnet2" }]] },
      "Export": { "Name": "devopshero-public-subnets" }
    },
    "PrivateSubnet1Id": {
      "Description": "Private Subnet 1 ID (for Fargate tasks)",
      "Value": { "Ref": "PrivateSubnet1" },
      "Export": { "Name": "devopshero-private-subnet-1" }
    },
    "PrivateSubnet2Id": {
      "Description": "Private Subnet 2 ID (for Fargate tasks)",
      "Value": { "Ref": "PrivateSubnet2" },
      "Export": { "Name": "devopshero-private-subnet-2" }
    },
    "PrivateSubnetIds": {
      "Description": "Comma-separated list of private subnet IDs (for Fargate tasks)",
      "Value": { "Fn::Join": [",", [{ "Ref": "PrivateSubnet1" }, { "Ref": "PrivateSubnet2" }]] },
      "Export": { "Name": "devopshero-private-subnets" }
    },
    "NatGatewayId": {
      "Description": "NAT Gateway ID",
      "Value": { "Ref": "NatGateway" },
      "Export": { "Name": "devopshero-nat-gateway-id" }
    },
    "NatGatewayEip": {
      "Description": "NAT Gateway Elastic IP",
      "Value": { "Ref": "NatGatewayEip" },
      "Export": { "Name": "devopshero-nat-eip" }
    },
    "DefaultSecurityGroupId": {
      "Description": "Default Security Group ID (VPC inbound, all outbound)",
      "Value": { "Ref": "DefaultSecurityGroup" },
      "Export": { "Name": "devopshero-default-sg-id" }
    }
  }
}
