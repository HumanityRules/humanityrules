# Slack Bot Token (starts with xoxb-)
# Get this from your Slack app's OAuth & Permissions page
SLACK_BOT_TOKEN=xoxb-your-token-here

# SQS Queue URL for receiving Slack events
# Events are pushed to this queue by an external ingress (API Gateway + Lambda)
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/slack-events

# AWS Region for SQS
AWS_REGION=us-east-1

# Optional: AWS credentials (if not using IAM roles or ~/.aws/credentials)
# AWS_ACCESS_KEY_ID=your-access-key
# AWS_SECRET_ACCESS_KEY=your-secret-key

# Optional: Log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
