# AWS Configuration
AWS_REGION=us-east-1

# SQS Queue URL (required for production)
SQS_QUEUE_URL=https://sqs.us-east-1.amazonaws.com/123456789012/my-job-queue

# S3 Bucket for job artifacts (required for transform_data jobs)
S3_BUCKET=my-job-artifacts-bucket

# Optional: Visibility timeout override (seconds)
# SQS_VISIBILITY_TIMEOUT=30

# Optional: Max messages per poll (1-10)
# SQS_MAX_MESSAGES=10

# Optional: Long poll wait time (seconds, 0-20)
# SQS_WAIT_TIME=20
