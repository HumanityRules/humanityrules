<div class="container">
  <section class="h-auto border border-blue">
    <div class="flex">
      <section class="py-4 w-1/5 resize-x overflow-auto border-r-2 border-gray-700 flex-shrink-0">
        <div class="flex flex-col">
          <h3 class="p-2 text-2xl text-blue-800 border-b border-gray-700">Commands</h3>
          <ul>
          <%= for command <- @historical_commands do %>
            <li class="border border-blue-300 p-2 m-1 rounded">
              <a href="#" phx-click="loadCommand" phx-value-command-id={command.id}><%= command.command %></a>
            </li>
          <% end %>
        </ul>
        </div>
      </section>

      <section class="w-4/5 flex-grow p-6 mt-4 bg-dodgerblue-100 h-full w-full">
        <h3 class="p-2 text-2xl text-blue-800 border-b border-gray-700">Submit AWSCLI Command</h3>
        <.form for={@form} phx-change="updateCommand" phx-submit="submitCommand">
          <div class="form-group">
            <%= textarea(@form, :command,
              phx_debounce: "blur",
              class: "form-control w-full h-40 resize-y"
            ) %>

          </div>

          <div class="flex justify-between"> 
            <div class="flex"> 
            <.button
              type="button"
              phx-click="performDryRun"
              phx-value-command={input_value(@form, :command)}
              class="mr-4"
            >
              Perform Dry Run
            </.button>

            <.button
              disabled={@dry_run_status != :ok}
              class="mr-4">
              Submit
            </.button>

            <.button
              type="button"
              disabled={@dry_run_status != :ok or Enum.empty?(@approved_users)}
              phx-click="runCommand"
              phx-value-command={input_value(@form, :command)}
              class="mr-4"
            >
              Run Command
            </.button>
            </div>
            <div>
            <.button
              type="button"
              disabled={!@is_data_engr}
              phx-click="approveCommand"
              class="mr-4"
            >
              Approve
            </.button>
            </div>
          </div>

          <div class="flex mt-4">
            <!-- Submitter Section -->
            <section class="p-4 border-t-2 border-blue-200 w-1/3">
              <h4 class="text-lg text-blue-800 font-bold mb-2">Submitted By:</h4>
              <p class="text-blue-600">
                <%= @submitter %>
              </p>
            </section>

            <!-- Approved By Section -->
            <section class="p-4 border-t-2 border-blue-200 w-2/3">
              <h4 class="text-lg text-blue-800 font-bold mb-2">Approved By:</h4>
              <ul>
                <%= for user <- @approved_users do %>
                  <li class="mb-1 text-blue-600">
                    <%= user.email %>
                  </li>
                <% end %>
              </ul>
            </section>
          </div>


          <h3 class="p-2 text-2xl text-blue-800 border-b border-gray-700">Command Output</h3>
          <pre class="border border-gray-300 p-2.5 overflow-auto max-h-50 bg-gray-100"><%= @command_output %></pre>
        </.form>
      </section>
    </div>
  </section>
</div>
