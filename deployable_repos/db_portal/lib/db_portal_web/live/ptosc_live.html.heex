<!-- outer container -->
<div class="mx-auto bg-white rounded-lg">
  <div class="">
    <!-- menus (prod/dev, schema) -->
    <.live_component      module = {DbPortalWeb.ReadOnlySchemaSelectorComponent}
      id= {1}
      envs= {~w(local dev prod)}
      env= {@env}
      schema= {@schema}
      permitted_schema_ids= {@permitted_schema_ids}
    />

    <div class="p-2 border shadow rounded-md">
      <!-- HEADER section -->
      <section class="flex flex-row justify-between">
        <h2 class="m-2 text-2xl text-ch-blue">
          PTOSC
        </h2>
        <div class="w-1/3 px-5 shadow-md">
          <h3 class="font-semibold tracking-wide">Resources</h3>
          <ul>
            <li class={if is_nil(@resource_id), do: ~S(hidden)}>
              <a
                target="_blank"
                href={ "https://us-east-1.console.aws.amazon.com/rds/home?region=us-east-1#performance-insights-v20206:/resourceId/#{@resource_id}" }
                class="text-blue-600 underline hover:text-blue-800 visited:text-purple-600"
              >
                Performance Insights
              </a>
            </li>
            <li>
              <a
                href="https://dev.mysql.com/doc/refman/5.7/en/innodb-online-ddl-operations.html"
                class="text-blue-600 underline hover:text-blue-800 visited:text-purple-600"
              >
                Mysql 5.7 Online operations
              </a>
            </li>
            <li>
              <a
                href="https://docs.aws.amazon.com/AmazonRDS/latest/AuroraUserGuide/AuroraMySQL.Managing.FastDDL.html"
                class="text-blue-600 underline hover:text-blue-800 visited:text-purple-600"
              >
                Aurora Online operations
              </a>
            </li>
            <li>
              <a
                href="https://aws.amazon.com/blogs/database/amazon-aurora-under-the-hood-fast-ddl/"
                class="text-blue-600 underline hover:text-blue-800 visited:text-purple-600"
              >
                Aurora Online operations blog post
              </a>
            </li>
          </ul>
        </div>
      </section>
      <!-- Main Section -->
      <section class="h-auto border border-blue">
        <div class="flex ">
          <!-- Job list -->
          <section class="py-4 w-1/5 resize-x overflow-auto border-r-2 border-gray-700">
            <h3 class="p-2 text-2xl text-blue-800 border-b border-gray-700">Jobs</h3>
            <%= for j <- @jobs do %>
              <.link patch={~p"/ptosc/job/#{j.id}"}
                class="block px-2 py-2 text-xs border-b border-gray-300"
              >
                <%= job_link_body(j) %>
              </.link>
            <% end %>
          </section>

          <!-- Right section -->
          <section class="w-4/5 flex-grow">
            <.live_component
              module={case @live_action do
               :new_job -> DbPortalWeb.Ptosc.NewJobComponent
               :launch -> DbPortalWeb.Ptosc.LaunchComponent
               :job -> DbPortalWeb.Ptosc.JobComponent
              end}
              id={:new}
              parms={@parms}
              schema={@schema}
              email={@email}
              progress={@progress}
              state={@state}
              job_req={@job_req}
              timezone={@timezone}
            />

          </section>

        </div>
      </section>
    </div>
  </div>
</div>
