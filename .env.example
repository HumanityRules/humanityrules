# WorkOS Authentication
WORKOS_CLIENT_ID=client_xxx
WORKOS_API_KEY=sk_test_xxx

# Humanity Rules API (for Lambda callbacks)
HUMR_API_ENDPOINT=https://your-tunnel.ngrok.io
HUMR_API_SECRET_KEY=your-secret-key

# Humanity Rules AWS Account (control plane)
HUMR_AWS_ACCOUNT_ID=555553041615
HUMR_AWS_ACCESS_KEY=your-access-key
HUMR_AWS_SECRET_KEY=your-secret-key

# Should the deployment worker automatically at startup, or wait for the manage.py command?
HUMR_RUN_JOB_WORKER=1

# Fake deployment mode, no AWS calls
HUMR_DEBUG_DEPLOYMENTS=1

# Use the remote EC2 docker builder instead of building locally (prod=1, local=0)
HUMR_USE_REMOTE_BUILDER=0

# Django settings
DJANGO_SECRET_KEY=$(python -c "import secrets; print(secrets.token_urlsafe(50))")
DJANGO_SUPERUSER_EMAIL=admin@example.com
# Debug mode (1=on). Defaults to on when unset.
DJANGO_DEBUG=1

# Database
# Local dev uses SQLite. Optional override of its path (defaults to local/db.sqlite3):
# HUMR_DB_PATH=local/db.sqlite3
# Alternative: point at a local Postgres instead of SQLite:
# DATABASE_URL=postgresql://user:pass@localhost:5432/humr
# In production DATABASE_HOST/PORT/NAME/USERNAME/PASSWORD are injected by ECS from Secrets Manager.

# Anthropic models: priority is ANTHROPIC_API_KEY > AWS_BEDROCK_REGION.
# Set this to call the Anthropic API directly instead of Bedrock.
ANTHROPIC_API_KEY=

# Bedrock support: For the Anthropic API client, we use these 3
AWS_BEDROCK_REGION=us-east-1
AWS_BEDROCK_ACCESS_KEY_ID=AKI...
AWS_BEDROCK_SECRET_ACCESS_KEY=Blah

# ...but the Agents SDK also needs this
CLAUDE_CODE_USE_BEDROCK=1

# Claude model aliases per conversation mode (opus-4.8, sonnet-4.6, opus-4.5, haiku-4.5)
CLAUDE_MODEL_GENERAL=opus-4.8
CLAUDE_MODEL_ENVIRONMENT=opus-4.8
CLAUDE_MODEL_APP_DEPLOYMENT=opus-4.8
# Claude Agent SDK input-stream close timeout (milliseconds).
# Increase this when turns can run many MCP tools before the first result;
# too low can cause tool calls to fail with "Stream closed" around the 60s mark.
CLAUDE_CODE_STREAM_CLOSE_TIMEOUT=600000

# Github App
GITHUB_APP_ID=2711968
GITHUB_APP_SLUG=humanity-rules
GITHUB_APP_CLIENT_ID=Iv23lis1OHLnOfOeRW0D
GITHUB_APP_CLIENT_SECRET=
# GITHUB_APP_PRIVATE_KEY_PATH=/path/to/humanity-rules.private-key.pem
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# PostHog Analytics
POSTHOG_API_KEY=phc_xxx
POSTHOG_HOST=https://us.i.posthog.com
# Reverse proxy to bypass ad blockers (leave empty for local dev)
# In production, set to: https://humanityrules.io/humr-ph
POSTHOG_PROXY_HOST=

# Environment SSO: signs per-environment session JWTs for deployed apps.
HUMR_ENV_SESSION_JWT_PRIVATE_KEY=
HUMR_ENV_SESSION_JWT_KID=

# Merge.dev agent handler (tenant-wide; stored only on HumR)
MERGE_AGENT_HANDLER_API_KEY=
MERGE_TOOL_PACK_ID=

# Telegram manager bot (creates/manages per-app bots on behalf of users)
TELEGRAM_MANAGER_BOT_TOKEN=
TELEGRAM_MANAGER_BOT_USERNAME=

# Humanity Rules Sandbox: shared demo account offered to every org.
# The sandbox IS the control plane's own AWS account. Leave unset to disable (e.g. local dev).
# All sandbox rows share ONE external id — generate it once (uuidgen) and keep it stable.
HUMR_SANDBOX_AWS_ACCOUNT_ID=555553041615
HUMR_SANDBOX_EXTERNAL_ID=generate-once-and-keep-stable
HUMR_SANDBOX_REGION=us-east-1
HUMR_SANDBOX_HOSTED_ZONE=humr.io

# Advanced / debug (optional)
# Override the policy-proxy (PDP) URL used during app deploys:
# HUMR_PDP_URL=
# Verbose debug for the humr_app_exec management command:
# HUMR_APP_EXEC_DEBUG=1
