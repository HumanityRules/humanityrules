{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "CloudFormation template to securely connect your AWS account to Humanity Rules.\n",
  "Parameters": {
    "ExternalId": {
      "Type": "String",
      "Description": "Do not modify! Used to prevent confused deputy attacks."
    },
    "ApiEndpoint": {
      "Type": "String",
      "Default": "",
      "Description": "Do not modify! Humanity Rules control-plane endpoint the install callback reports back to."
    }
  },
  "Outputs": {
    "RoleArn": {
      "Description": "The ARN of the IAM role created for Humanity Rules",
      "Value": { "Fn::GetAtt": ["HumanityRulesRole", "Arn"] }
    },
    "AccountId": {
      "Description": "Your AWS Account ID",
      "Value": { "Ref": "AWS::AccountId" }
    }
  },
  "Resources": {
    "HumanityRulesRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": {
          "Fn::Join": [
            "-",
            [
              "humr",
              {
                "Ref": "ExternalId"
              }
            ]
          ]
        },
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": "arn:aws:iam::555553041615:root"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "sts:ExternalId": {
                    "Ref": "ExternalId"
                  }
                }
              }
            }
          ]
        },
        "ManagedPolicyArns": ["arn:aws:iam::aws:policy/AdministratorAccess"]
      }
    },
    "HumanityRulesInstallCallback": {
      "Type": "Custom::HumanityRulesInstallCallback",
      "DependsOn": "HumanityRulesRole",
      "Properties": {
        "ServiceToken": "arn:aws:lambda:us-east-1:555553041615:function:humr-prod-install-callback",
        "AwsAccount": { "Ref": "AWS::AccountId" },
        "StackRegion": { "Ref": "AWS::Region" },
        "RoleArn": { "Fn::GetAtt": ["HumanityRulesRole", "Arn"] },
        "ExternalId": { "Ref": "ExternalId" },
        "ApiEndpoint": { "Ref": "ApiEndpoint" }
      }
    }
  }
}
