django: uv run uvicorn humanityrules_site.asgi:application --reload --host 127.0.0.1 --port 8000 --timeout-graceful-shutdown 0 --reload-exclude "$(pwd)/local" --reload-include "*.html" --reload-include "*.css" --reload-include "*.js" --log-level info
tailwind: python manage.py tailwind start > /dev/null 2>&1

