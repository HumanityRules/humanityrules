{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Django ASGI (Uvicorn)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "devopshero_site.asgi:application",
                "--host", "127.0.0.1",
                "--port", "8000",
                "--timeout-graceful-shutdown", "0",
                "--log-level", "warning"
            ],
            "django": true,
            "autoStartBrowser": false,
            "console": "integratedTerminal"
        },
        {
            "name": "Test: Repo Analysis",
            "type": "debugpy",
            "request": "launch",
            "module": "devopshero_app.services.agent.repo_analysis.test_repo_analysis",
            "args": ["--app", "fastapi_app"],
            "env": {
                "DJANGO_SETTINGS_MODULE": "devopshero_site.settings"
            },
            "console": "integratedTerminal"
        },
        {
            "name": "Test: Main Agent",
            "type": "debugpy",
            "request": "launch",
            "module": "devopshero_app.services.agent.test_main_agent",
            "args": ["--repl", "--conversation-id", "019bc7e3-f78f-74bc-9490-003bd8264dab", "--db-run", "test_db/my_test.sqlite3", "--no-copy"],
            "env": {
                "DJANGO_SETTINGS_MODULE": "devopshero_site.settings"
            },
            "console": "integratedTerminal"
        },
    ]
}