{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Deploy App",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/infra_customer/deploy_app.py",
            "args": [
            ],
            "console": "integratedTerminal"
        },
        {
            "name": "Python Debugger: Django WSGI",
            "type": "debugpy",
            "request": "launch",
            "args": [
                "runserver"
            ],
            "django": true,
            "autoStartBrowser": false,
            "program": "${workspaceFolder}/manage.py"
        },
        {
            "name": "Python Debugger: Django ASGI (Uvicorn)",
            "type": "debugpy",
            "request": "launch",
            "module": "uvicorn",
            "args": [
                "devopshero_site.asgi:application",
                "--host", "127.0.0.1",
                "--port", "8000",
                "--timeout-graceful-shutdown", "0"
            ],
            "django": true,
            "autoStartBrowser": false,
            "console": "integratedTerminal"
        },
        {
            "name": "Test: Repo Analysis",
            "type": "debugpy",
            "request": "launch",
            "module": "devopshero_app.services.agent.repo_analysis.test_repo_analysis",
            "args": ["--app", "fastapi_app"],
            "env": {
                "DJANGO_SETTINGS_MODULE": "devopshero_site.settings"
            },
            "console": "integratedTerminal"
        },
    ]
}