{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "DevOpsHero Install Callback Lambda used to notify the DevOpsHero backend when customers deploy the AWS account",
  
  "Parameters": {
    "DevOpsHeroApiEndpoint": {
      "Type": "String",
      "Description": "The HTTPS endpoint of your DevOpsHero backend API (e.g., https://api.devopshero.io)",
      "Default": "https://api.devopshero.io"
    },
    "ApiSecretKey": {
      "Type": "String",
      "Description": "Secret key used to authenticate Lambda calls to your backend",
      "NoEcho": true
    },
    "LambdaCodeS3Bucket": {
      "Type": "String",
      "Description": "S3 bucket containing the Lambda code ZIP file",
      "Default": "devopshero-lambda-code"
    },
    "LambdaCodeS3Key": {
      "Type": "String",
      "Description": "S3 key (path) to the Lambda code ZIP file",
      "Default": "install_callback_lambda.zip"
    }
  },

  "Resources": {
    "InstallCallbackLambdaRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "RoleName": "devopshero-install-callback-lambda-role",
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "lambda.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/service-role/AWSLambdaBasicExecutionRole"
        ]
      }
    },

    "InstallCallbackLambdaLogGroup": {
      "Type": "AWS::Logs::LogGroup",
      "Properties": {
        "LogGroupName": "/aws/lambda/devopshero-install-callback",
        "RetentionInDays": 731
      }
    },

    "InstallCallbackLambda": {
      "Type": "AWS::Lambda::Function",
      "DependsOn": "InstallCallbackLambdaLogGroup",
      "Properties": {
        "FunctionName": "devopshero-install-callback",
        "Description": "Handles CloudFormation Custom Resource callbacks when customers connect their AWS accounts",
        "Runtime": "python3.12",
        "Handler": "install_callback_lambda.handler",
        "Timeout": 30,
        "MemorySize": 128,
        "Role": { "Fn::GetAtt": ["InstallCallbackLambdaRole", "Arn"] },
        "Environment": {
          "Variables": {
            "DEVOPSHERO_API_ENDPOINT": { "Ref": "DevOpsHeroApiEndpoint" },
            "API_SECRET_KEY": { "Ref": "ApiSecretKey" }
          }
        },
        "Code": {
          "S3Bucket": { "Ref": "LambdaCodeS3Bucket" },
          "S3Key": { "Ref": "LambdaCodeS3Key" }
        }
      }
    },

    "InstallCallbackLambdaPermission": {
      "Type": "AWS::Lambda::Permission",
      "Properties": {
        "FunctionName": { "Ref": "InstallCallbackLambda" },
        "Action": "lambda:InvokeFunction",
        "Principal": "*"
      }
    }
  },

  "Outputs": {
    "LambdaArn": {
      "Description": "ARN of the Install Callback Lambda - use this as ServiceToken in customer CF templates",
      "Value": { "Fn::GetAtt": ["InstallCallbackLambda", "Arn"] },
      "Export": {
        "Name": "DevOpsHeroInstallCallbackLambdaArn"
      }
    },
    "LambdaName": {
      "Description": "Name of the Install Callback Lambda",
      "Value": { "Ref": "InstallCallbackLambda" }
    }
  }
}
